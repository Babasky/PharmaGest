{% extends 'layout/app.html.twig' %}

{% block title %}Recettes{% endblock %}

{% block page_actions %}
    <a class="btn btn-outline-secondary" href="{{ path('app_rapport_voir', {code: 'finances'}|merge(periode.parametres)) }}"><i class="bi bi-bar-chart-line"></i> Rapport financier</a>
{% endblock %}

{% block content %}
    {% include 'rapport/_periode.html.twig' with {route: 'app_recette_index', params: {origine: origine}} %}
    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <form method="get" class="d-flex flex-wrap gap-2 mb-3">
                {% for nom, valeur in periode.parametres %}<input type="hidden" name="{{ nom }}" value="{{ valeur }}">{% endfor %}
                <select name="origine" class="form-select" style="max-width: 16rem" aria-label="Origine">
                    <option value="">Toutes les origines</option>
                    {% for o in origines %}<option value="{{ o.value }}"{{ origine == o.value ? ' selected' }}>{{ o.libelle }}</option>{% endfor %}
                </select>
                <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-funnel"></i> Filtrer</button>
            </form>
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="recettes">
                        <thead class="table-light">
                            <tr><th class="ps-3">Date</th><th>Origine</th><th>Libellé</th><th>Mode</th><th class="text-end">Montant</th><th class="pe-3"></th></tr>
                        </thead>
                        <tbody>
                            {% for recette in recettes %}
                                <tr>
                                    <td class="ps-3 small text-nowrap">{{ recette.date|date('d/m/Y') }}</td>
                                    <td><span class="badge text-bg-{{ recette.origine.couleur }}">{{ recette.origine.libelle }}</span></td>
                                    <td>
                                        {% if recette.vente %}<a class="text-decoration-none" href="{{ path('app_vente_voir', {id: recette.vente.id}) }}">{{ recette.libelle }}</a>{% else %}{{ recette.libelle }}{% endif %}
                                        {% if recette.estAnnulee %} <span class="badge text-bg-secondary">Annulée</span>{% endif %}
                                    </td>
                                    <td class="small">{{ recette.mode.libelle }}</td>
                                    <td class="montant{{ recette.montant < 0 ? ' text-danger' }}">{{ recette.montant|fcfa }}</td>
                                    <td class="pe-3 text-end">
                                        {% if recette.origine.value == 'manuelle' and not recette.estAnnulee and ecriture_autorisee() %}
                                            <form method="post" action="{{ path('app_recette_annuler', {id: recette.id}) }}" class="d-flex gap-1 justify-content-end annulation-recette">
                                                <input type="hidden" name="_token" value="{{ csrf_token('recette-' ~ recette.id) }}">
                                                <input class="form-control form-control-sm" style="width: 9rem" name="motif" placeholder="Motif" aria-label="Motif de l'annulation" required>
                                                <button class="btn btn-sm btn-outline-danger" type="submit">Annuler</button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6" class="text-center text-body-secondary py-4">Aucune recette sur la période.</td></tr>
                            {% endfor %}
                        </tbody>
                        <tfoot class="table-light fw-semibold">
                            <tr><td class="ps-3" colspan="4">Total de la période (contre-passations déduites)</td><td class="montant" id="total-recettes">{{ total|fcfa }}</td><td></td></tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            {% include 'layout/_pagination.html.twig' with {page: recettes, route: 'app_recette_index', params: periode.parametres|merge({origine: origine})} %}
        </div>
        <div class="col-12 col-xl-4">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-body fw-semibold">Par origine</div>
                <ul class="list-group list-group-flush small" id="par-origine">
                    {% for o in origines|filter(o => o.value != 'contre_passation') %}
                        <li class="list-group-item d-flex justify-content-between"><span>{{ o.libelle }}</span><span class="text-nowrap">{{ (par_origine[o.value] ?? 0)|fcfa }}</span></li>
                    {% endfor %}
                </ul>
                <div class="card-footer bg-body small text-body-secondary">
                    Les ventes et règlements AMO entrent automatiquement (part assuré seulement pour une vente AMO) ; une annulation est contre-passée.
                </div>
            </div>
            {% if ecriture_autorisee() %}
                <div class="card shadow-sm" id="nouvelle-recette">
                    <div class="card-header bg-body fw-semibold">Autre recette</div>
                    <div class="card-body">
                        <form method="post" action="{{ path('app_recette_nouvelle') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token(csrf_nouvelle) }}">
                            <div class="mb-2">
                                <label class="form-label" for="recette-date">Date</label>
                                <input class="form-control" type="date" id="recette-date" name="date" value="{{ aujourdhui|date('Y-m-d') }}" max="{{ aujourdhui|date('Y-m-d') }}" required>
                            </div>
                            <div class="mb-2">
                                <label class="form-label" for="recette-libelle">Libellé</label>
                                <input class="form-control" id="recette-libelle" name="libelle" maxlength="150" placeholder="Ex. : location d'un local, prestation" required>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label" for="recette-montant">Montant (FCFA)</label>
                                    <input class="form-control" id="recette-montant" name="montant" inputmode="numeric" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label" for="recette-mode">Mode</label>
                                    <select class="form-select" id="recette-mode" name="mode">
                                        {% for m in modes %}<option value="{{ m.value }}">{{ m.libelle }}</option>{% endfor %}
                                    </select>
                                </div>
                            </div>
                            <button class="btn btn-success" type="submit">Enregistrer la recette</button>
                        </form>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
