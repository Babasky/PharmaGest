<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ rapport.titre }} — {{ rapport.periode.libelle }}</title>
    <style>
        @page { margin: 12mm 10mm; }
        body { font-family: 'DejaVu Sans', sans-serif; font-size: 8pt; color: #1f2a24; }
        h1 { font-size: 14pt; margin: 0 0 1mm; color: #198754; }
        h2 { font-size: 10pt; margin: 5mm 0 1.5mm; }
        .petit { font-size: 7pt; color: #555; }
        table.lignes { width: 100%; border-collapse: collapse; page-break-inside: auto; }
        table.lignes tr { page-break-inside: avoid; }
        table.lignes th { background: #e9f3ee; text-align: left; padding: 1.2mm; border-bottom: 1px solid #198754; font-size: 7pt; }
        table.lignes td { padding: 1.2mm; border-bottom: 1px solid #ddd; vertical-align: top; }
        table.lignes tr.total td { font-weight: bold; border-top: 1px solid #198754; border-bottom: none; background: #f4f9f6; }
        .droite { text-align: right; white-space: nowrap; }
        .note { font-size: 6.5pt; color: #555; font-style: italic; margin-top: 1mm; }
    </style>
</head>
<body>
    <table width="100%">
        <tr>
            <td width="60%"><h1>{{ rapport.titre }}</h1><div style="font-size: 11pt; font-weight: bold;">{{ rapport.periode.libelle }}</div></td>
            <td width="40%" class="droite" style="vertical-align: top;">
                <strong>{{ pharmacie.nom }}</strong><br>
                <span class="petit">Édité le {{ edite_le|date('d/m/Y à H:i') }} (heure de Bamako)</span>
            </td>
        </tr>
    </table>

    {% for tableau in rapport.tableaux %}
        <h2>{{ tableau.titre }}</h2>
        <table class="lignes">
            <thead>
                <tr>{% for libelle, type in tableau.colonnes %}<th{{ type not in ['texte', 'date'] ? ' class="droite"' }}>{{ libelle }}</th>{% endfor %}</tr>
            </thead>
            <tbody>
                {% for ligne in tableau.lignes %}
                    {% set n = loop.index0 %}
                    <tr>{% for valeur in ligne %}{% set type = tableau.type(n, loop.index0) %}<td{{ type not in ['texte', 'date'] ? ' class="droite"' }}>{{ valeur|cellule(type) }}</td>{% endfor %}</tr>
                {% else %}
                    <tr><td colspan="{{ tableau.colonnes|length }}" class="petit">Aucune donnée sur la période.</td></tr>
                {% endfor %}
                {% if tableau.total and tableau.lignes is not empty %}
                    <tr class="total">{% for valeur in tableau.total %}{% set type = tableau.types[loop.index0] %}<td{{ type not in ['texte', 'date'] ? ' class="droite"' }}>{{ valeur is null ? '' : valeur|cellule(type) }}</td>{% endfor %}</tr>
                {% endif %}
            </tbody>
        </table>
        {% if tableau.note %}<div class="note">{{ tableau.note }}</div>{% endif %}
    {% endfor %}
</body>
</html>
