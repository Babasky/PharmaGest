{# Bouton archiver / restaurer (RG-15). Paramètres : entite, route. #}
<form method="post" action="{{ path(route, {id: entite.id}) }}" class="mt-3">
    <input type="hidden" name="_token" value="{{ csrf_token('archiver-' ~ entite.id) }}">
    {% if entite.actif %}
        <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-archive"></i> Archiver</button>
        <span class="small text-body-secondary ms-1">Il disparaîtra des listes de choix ; son historique est conservé.</span>
    {% else %}
        <button class="btn btn-sm btn-outline-success" type="submit"><i class="bi bi-arrow-counterclockwise"></i> Restaurer</button>
    {% endif %}
</form>
