<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="turbo-prefetch" content="false">
        <title>{% block title %}{{ app_name }}{% endblock %}{% if block('title') != app_name %} · {{ app_name }}{% endif %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><rect width=%2216%22 height=%2216%22 rx=%223%22 fill=%22%23198754%22/><path d=%22M6.5 3h3v3.5H13v3H9.5V13h-3V9.5H3v-3h3.5z%22 fill=%22%23fff%22/></svg>">
        <script>
            {# Thème et état du menu appliqués avant l'affichage (pas de clignotement ; <html> persiste entre les visites Turbo). #}
            try {
                document.documentElement.dataset.bsTheme = localStorage.getItem('pg-theme') === 'dark' ? 'dark' : 'light';
                document.documentElement.classList.toggle('pg-sidebar-reduit', localStorage.getItem('pg-sidebar') === 'reduit');
            } catch (e) {}
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&display=swap">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        {% block body %}{% endblock %}
    </body>
</html>
