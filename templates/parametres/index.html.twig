{% extends 'layout/app.html.twig' %}

{% block title %}Paramètres{% endblock %}

{% block content %}
    <ul class="nav nav-tabs mb-3" role="tablist">
        {% for cle, libelle in {fiche: 'Fiche de la pharmacie', regles: 'Règles de gestion', amo: 'Taux AMO et assurances', caisses: 'Caisses'} %}
            <li class="nav-item" role="presentation">
                <a class="nav-link{{ onglet == cle ? ' active' }}" href="{{ path('app_parametres', {onglet: cle}) }}"{% if onglet == cle %} aria-current="page"{% endif %}>{{ libelle }}</a>
            </li>
        {% endfor %}
    </ul>

    {% if onglet == 'fiche' %}
        <div class="card shadow-sm" style="max-width: 46rem">
            <div class="card-body">
                {{ form_start(fiche) }}
                <div class="d-flex align-items-center gap-3 mb-3">
                    {% if pharmacie.logo %}
                        <img src="{{ path('app_parametres_logo') }}" alt="Logo de {{ pharmacie.nom }}" class="border rounded bg-white p-1" style="max-height: 4.5rem; max-width: 10rem">
                    {% else %}
                        <div class="border rounded d-flex align-items-center justify-content-center text-body-secondary small bg-body" style="height: 4.5rem; width: 7rem">Pas de logo</div>
                    {% endif %}
                    <div class="flex-grow-1">{{ form_row(fiche.logo) }}</div>
                </div>
                {{ form_widget(fiche) }}
                <button class="btn btn-success" type="submit">Enregistrer la fiche</button>
                {{ form_end(fiche) }}
            </div>
        </div>
    {% elseif onglet == 'regles' %}
        <div class="card shadow-sm" style="max-width: 46rem">
            <div class="card-body">
                {{ form_start(regles) }}
                {{ form_widget(regles) }}
                <button class="btn btn-success" type="submit">Enregistrer les règles</button>
                {{ form_end(regles) }}
            </div>
        </div>
    {% elseif onglet == 'amo' %}
        <div class="row g-3">
            <div class="col-12 col-lg-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-body fw-semibold">Taux en vigueur aujourd'hui</div>
                    <ul class="list-group list-group-flush">
                        {% for ligne in taux_en_vigueur %}
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="min-w-0">{{ ligne.organisme.nom }} <span class="badge text-bg-light border">{{ ligne.organisme.type.libelle }}</span>{% if not ligne.organisme.commun %} <span class="badge text-bg-success-subtle text-success-emphasis border">Ajoutée par la pharmacie</span>{% endif %}</span>
                                <strong class="text-nowrap ms-2">{{ ligne.taux }}&nbsp;%</strong>
                            </li>
                        {% else %}
                            <li class="list-group-item text-body-secondary">Aucune assurance : ajoutez celles de vos clients ci-contre.</li>
                        {% endfor %}
                    </ul>
                    <div class="card-body small text-body-secondary">Sans taux saisi, SoftPharm applique 70 %. Un nouveau taux ne modifie jamais les ventes déjà enregistrées.</div>
                </div>
            </div>
            <div class="col-12 col-lg-7">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-body fw-semibold">Nouveau taux</div>
                    <div class="card-body">
                        {{ form_start(form_taux) }}
                        <div class="row g-2">
                            <div class="col-12 col-md-5">{{ form_row(form_taux.organisme) }}</div>
                            <div class="col-6 col-md-3">{{ form_row(form_taux.taux) }}</div>
                            <div class="col-6 col-md-4">{{ form_row(form_taux.dateEffet) }}</div>
                        </div>
                        <button class="btn btn-success" type="submit">Ajouter ce taux</button>
                        {{ form_end(form_taux) }}
                    </div>
                </div>
                <div class="card shadow-sm mb-3" id="assurances-pharmacie">
                    <div class="card-header bg-body fw-semibold">Ajouter une assurance</div>
                    <div class="card-body">
                        <p class="small text-body-secondary">Une assurance (AMO ou autre) absente de la liste : elle ne sera visible que dans votre pharmacie.</p>
                        {{ form_start(form_organisme) }}
                        <div class="row g-2">
                            <div class="col-12 col-md-6">{{ form_row(form_organisme.nom) }}</div>
                            <div class="col-6 col-md-3">{{ form_row(form_organisme.code) }}</div>
                            <div class="col-6 col-md-3">{{ form_row(form_organisme.type) }}</div>
                        </div>
                        <button class="btn btn-success" type="submit">Ajouter cette assurance</button>
                        {{ form_end(form_organisme) }}
                    </div>
                    {% if organismes_pharmacie is not empty %}
                        <ul class="list-group list-group-flush" id="liste-assurances-pharmacie">
                            {% for o in organismes_pharmacie %}
                                <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                    <span class="min-w-0{{ o.actif ? '' : ' text-body-secondary' }}">{{ o.code }} · {{ o.nom }} <span class="badge text-bg-light border">{{ o.type.libelle }}</span>{% if not o.actif %} <span class="badge text-bg-secondary">Archivée</span>{% endif %}</span>
                                    <form method="post" action="{{ path('app_parametres_organisme_archiver', {id: o.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('organisme-' ~ o.id) }}">
                                        <button class="btn btn-sm btn-outline-secondary text-nowrap" type="submit">{{ o.actif ? 'Archiver' : 'Réactiver' }}</button>
                                    </form>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
                <div class="card shadow-sm">
                    <div class="card-header bg-body fw-semibold">Historique</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light"><tr><th class="ps-3">Organisme</th><th>À partir du</th><th class="text-end pe-3">Taux</th></tr></thead>
                            <tbody>
                                {% for taux in historique_taux %}
                                    <tr><td class="ps-3">{{ taux.organisme.nom }}</td><td>{{ taux.dateEffet|date('d/m/Y') }}</td><td class="text-end pe-3 text-nowrap">{{ taux.taux }}&nbsp;%</td></tr>
                                {% else %}
                                    <tr><td colspan="3" class="text-center text-body-secondary py-3">Aucun taux saisi : 70 % s'applique partout.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    {% elseif onglet == 'caisses' %}
        {% set jeton_caisses = csrf_token('caisses') %}
        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card shadow-sm" id="liste-caisses">
                    <div class="card-header fw-semibold"><i class="bi bi-safe"></i> Caisses de la pharmacie</div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th class="ps-3">Nom</th><th>État</th><th class="text-end pe-3">Actions</th></tr></thead>
                            <tbody>
                                {% for ligne in caisses %}
                                    {% set c = ligne.caisse %}
                                    <tr class="{{ c.actif ? '' : 'text-body-secondary' }}">
                                        <td class="ps-3">
                                            <form method="post" action="{{ path('app_parametres_caisse_renommer', {id: c.id}) }}" class="d-flex gap-2">
                                                <input type="hidden" name="_token" value="{{ jeton_caisses }}">
                                                <input type="text" class="form-control form-control-sm" name="libelle" value="{{ c.libelle }}" maxlength="60" aria-label="Nom de la caisse" required>
                                                <button class="btn btn-sm btn-outline-secondary" type="submit" title="Renommer"><i class="bi bi-check-lg"></i></button>
                                            </form>
                                        </td>
                                        <td>
                                            {% if not c.actif %}<span class="badge text-bg-secondary">Hors service</span>
                                            {% elseif ligne.session %}<span class="badge text-bg-success">Ouverte</span> <span class="small">par {{ ligne.session.utilisateur.nom }}</span>
                                            {% else %}<span class="badge text-bg-light border">Fermée</span>{% endif %}
                                        </td>
                                        <td class="text-end pe-3">
                                            <form method="post" action="{{ path('app_parametres_caisse_basculer', {id: c.id}) }}">
                                                <input type="hidden" name="_token" value="{{ jeton_caisses }}">
                                                <button class="btn btn-sm btn-outline-{{ c.actif ? 'danger' : 'success' }}" type="submit">{{ c.actif ? 'Retirer du service' : 'Remettre en service' }}</button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h6"><i class="bi bi-plus-circle"></i> Ajouter une caisse</h2>
                        <p class="small text-body-secondary">
                            Une seule caisse suffit le plus souvent : toute l'équipe y encaisse, chacun validant ses ventes avec son code PIN.
                            Ajoutez-en une si la pharmacie a un deuxième tiroir-caisse, puis choisissez-la sur le poste qui l'utilise (« Ce poste » sur l'écran de caisse).
                        </p>
                        <form method="post" action="{{ path('app_parametres_caisse_ajouter') }}" id="ajouter-caisse">
                            <input type="hidden" name="_token" value="{{ jeton_caisses }}">
                            <label class="form-label" for="caisse-libelle">Nom</label>
                            <input type="text" class="form-control mb-2" id="caisse-libelle" name="libelle" maxlength="60" placeholder="Caisse 2" required>
                            <button class="btn btn-success" type="submit"><i class="bi bi-plus-lg"></i> Ajouter la caisse</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
