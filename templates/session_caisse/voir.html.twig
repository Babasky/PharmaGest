{% extends 'layout/app.html.twig' %}

{% block title %}Session de caisse {{ session.numero }}{% endblock %}

{% block page_actions %}
    <a class="btn btn-outline-secondary" href="{{ path('app_session_caisse_index') }}"><i class="bi bi-arrow-left"></i> Sessions</a>
    {% if session.estOuverte %}
        {% if session.utilisateur.id == app.user.id %}<a class="btn btn-success" href="{{ path('app_caisse') }}"><i class="bi bi-cart-plus"></i> Retour à la caisse</a>{% endif %}
    {% else %}
        <a class="btn btn-success" href="{{ path('app_session_caisse_rapport_z', {id: session.id}) }}" target="_blank"><i class="bi bi-file-earmark-pdf"></i> Rapport Z</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
        <span class="badge fs-6 text-bg-{{ session.estOuverte ? 'success' : 'secondary' }}">{{ session.estOuverte ? 'Ouverte' : 'Clôturée' }}</span>
        <span>{{ session.utilisateur.nom }}</span>
        <span class="small text-body-secondary">Ouverte le {{ session.ouverteLe|date('d/m/Y H:i') }}{% if session.clotureeLe %} · clôturée le {{ session.clotureeLe|date('d/m/Y H:i') }}{{ session.clotureePar ? ' par ' ~ session.clotureePar.nom }}{% endif %}</span>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm mb-3" id="synthese">
                <div class="card-header bg-body fw-semibold">Ventes de la session</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-7 fw-normal">Ventes</dt><dd class="col-5 text-end">{{ synthese.nombreVentes }}</dd>
                        <dt class="col-7 fw-normal">Chiffre d'affaires (part AMO comprise)</dt><dd class="col-5 montant">{{ synthese.chiffreAffaires|fcfa }}</dd>
                        <dt class="col-7 fw-normal">Dont part AMO (créances)</dt><dd class="col-5 montant">{{ synthese.partAmo|fcfa }}</dd>
                        <dt class="col-7 fw-normal">Remises accordées</dt><dd class="col-5 montant">{{ synthese.remises|fcfa }}</dd>
                        <dt class="col-7 fw-normal">Annulations</dt><dd class="col-5 text-end">{{ synthese.nombreAnnulations }} ({{ synthese.montantAnnule|fcfa }})</dd>
                    </dl>
                </div>
                <table class="table table-sm mb-0">
                    <thead class="table-light small"><tr><th class="ps-3">Mode</th><th class="text-end">Encaissé</th><th class="text-end">Remboursé</th><th class="text-end pe-3">Net</th></tr></thead>
                    <tbody>
                        {% for mode in enum_cases('App\\Enum\\ModePaiement') %}
                            <tr>
                                <td class="ps-3">{{ mode.libelle }}</td>
                                <td class="montant">{{ synthese.encaissements[mode.value]|fcfa }}</td>
                                <td class="montant">{{ synthese.decaissements[mode.value]|fcfa }}</td>
                                <td class="montant pe-3 fw-semibold">{{ synthese.net(mode)|fcfa }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm" id="especes">
                <div class="card-header bg-body fw-semibold">Espèces</div>
                <div class="card-body">
                    <dl class="row mb-3">
                        <dt class="col-7 fw-normal">Fond de caisse</dt><dd class="col-5 montant">{{ session.fondCaisse|fcfa }}</dd>
                        <dt class="col-7 fw-normal">+ Encaissements espèces</dt><dd class="col-5 montant">{{ synthese.encaissements.especes|fcfa }}</dd>
                        <dt class="col-7 fw-normal">− Remboursements espèces</dt><dd class="col-5 montant">{{ synthese.decaissements.especes|fcfa }}</dd>
                        <dt class="col-7">Espèces attendues</dt><dd class="col-5 montant fw-bold" id="attendues">{{ (session.estOuverte ? synthese.especesAttendues : session.especesAttendues)|fcfa }}</dd>
                        {% if not session.estOuverte %}
                            <dt class="col-7">Espèces comptées</dt><dd class="col-5 montant fw-bold">{{ session.especesComptees|fcfa }}</dd>
                            <dt class="col-7">Écart</dt><dd class="col-5 montant fw-bold {{ session.ecart != 0 ? 'text-danger' : 'text-success' }}" id="ecart">{{ session.ecart|fcfa }}</dd>
                            {% if session.justification %}<dt class="col-12 fw-normal small text-body-secondary">Justification : {{ session.justification }}</dt>{% endif %}
                        {% endif %}
                    </dl>

                    {% if session.estOuverte and ecriture_autorisee() %}
                        <form method="post" action="{{ path('app_session_caisse_cloturer', {id: session.id}) }}" id="cloture">
                            <input type="hidden" name="_token" value="{{ csrf_token('cloture-' ~ session.id) }}">
                            <p class="small text-body-secondary">Comptez les billets et pièces du tiroir. L'écart (RG-13) est calculé à la validation ; s'il n'est pas nul, une justification est obligatoire.</p>
                            <div class="row g-2">
                                {% for cle, coupure in coupures %}
                                    <div class="col-6 col-md-4">
                                        <label class="form-label small mb-0" for="coupure-{{ cle }}">{{ coupure[0] }}</label>
                                        <input type="number" min="0" step="1" inputmode="numeric" class="form-control form-control-sm text-end" id="coupure-{{ cle }}" name="comptage[{{ cle }}]">
                                    </div>
                                {% endfor %}
                            </div>
                            <label class="form-label small mt-2" for="justification">Justification de l'écart</label>
                            <textarea class="form-control form-control-sm" id="justification" name="justification" rows="2" maxlength="1000"></textarea>
                            <button class="btn btn-danger mt-3" type="submit" data-turbo-confirm="Clôturer la session {{ session.numero }} ?"><i class="bi bi-lock"></i> Clôturer la caisse</button>
                        </form>
                    {% elseif not session.estOuverte and session.comptage is not empty %}
                        <table class="table table-sm small mb-0">
                            {% for cle, nombre in session.comptage %}
                                <tr><td>{{ coupures[cle][0] }}</td><td class="text-end">× {{ nombre }}</td><td class="montant">{{ (coupures[cle][1] * nombre)|fcfa }}</td></tr>
                            {% endfor %}
                        </table>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
