{% extends 'layout/app.html.twig' %}

{% block title %}Catégories de produits{% endblock %}

{% block content %}
    <div class="row g-3">
        <div class="col-12 col-lg-7 order-2 order-lg-1">
            <div class="card shadow-sm">
                <ul class="list-group list-group-flush">
                    {% for categorie in categories %}
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2{{ categorie.parent ? ' ps-5' }}{{ categorie.actif ? '' : ' text-body-secondary' }}">
                            <span class="min-w-0 text-truncate">
                                {% if categorie.parent %}<i class="bi bi-arrow-return-right text-body-tertiary"></i>{% else %}<i class="bi bi-folder2 text-success"></i>{% endif %}
                                <span class="{{ categorie.parent ? '' : 'fw-semibold' }}">{{ categorie.nom }}</span>
                                {% if not categorie.actif %}<span class="badge text-bg-secondary ms-1">Archivée</span>{% endif %}
                            </span>
                            {% if ecriture_autorisee() %}
                                <span class="text-nowrap d-flex gap-1">
                                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_categorie_modifier', {id: categorie.id}) }}" title="Modifier"><i class="bi bi-pencil"></i><span class="visually-hidden">Modifier {{ categorie.nom }}</span></a>
                                    <form method="post" action="{{ path('app_categorie_archiver', {id: categorie.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('archiver-' ~ categorie.id) }}">
                                        <button class="btn btn-sm btn-outline-{{ categorie.actif ? 'danger' : 'success' }}" title="{{ categorie.actif ? 'Archiver' : 'Restaurer' }}"><i class="bi bi-{{ categorie.actif ? 'archive' : 'arrow-counterclockwise' }}"></i><span class="visually-hidden">{{ categorie.actif ? 'Archiver' : 'Restaurer' }} {{ categorie.nom }}</span></button>
                                    </form>
                                </span>
                            {% endif %}
                        </li>
                    {% else %}
                        <li class="list-group-item text-center text-body-secondary py-4">Aucune catégorie. Créez d'abord les catégories principales (Médicaments, Parapharmacie…), puis leurs sous-catégories.</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        {% if ecriture_autorisee() %}
            <div class="col-12 col-lg-5 order-1 order-lg-2">
                <div class="card shadow-sm">
                    <div class="card-header bg-body fw-semibold">Nouvelle catégorie</div>
                    <div class="card-body">
                        {{ form_start(formulaire) }}
                        {{ form_widget(formulaire) }}
                        <button class="btn btn-success" type="submit">Créer</button>
                        {{ form_end(formulaire) }}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
