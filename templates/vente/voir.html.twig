{% extends 'layout/app.html.twig' %}

{% block title %}Vente {{ vente.numero }}{% endblock %}

{% block page_actions %}
    {% if depuis_caisse %}
        <a class="btn btn-success" href="{{ path('app_caisse') }}" autofocus><i class="bi bi-cart-plus"></i> Vente suivante</a>
    {% else %}
        <a class="btn btn-outline-secondary" href="{{ path('app_vente_index') }}"><i class="bi bi-arrow-left"></i> Ventes</a>
    {% endif %}
    <a class="btn btn-outline-success" href="{{ path('app_vente_ticket', {id: vente.id}) }}" target="_blank"><i class="bi bi-printer"></i> Ticket</a>
    <a class="btn btn-outline-success" href="{{ path('app_vente_facture', {id: vente.id}) }}" target="_blank"><i class="bi bi-file-earmark-text"></i> Facture A4</a>
{% endblock %}

{% block content %}
    {% set amo = vente.type.value == 'amo' %}
    <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
        <span class="badge fs-6 text-bg-{{ vente.statut.couleur }}" id="statut">{{ vente.statut.libelle }}</span>
        <span>{{ vente.type.libelle }}</span>
        <span class="small text-body-secondary">{{ vente.valideeLe|date('d/m/Y H:i') }} · {{ vente.vendeur.nom }} · session {{ vente.session ? vente.session.numero }}</span>
    </div>

    {% if vente.statut.value == 'annulee' %}
        <div class="alert alert-secondary"><i class="bi bi-x-circle"></i> Annulée le {{ vente.annuleeLe|date('d/m/Y H:i') }}{{ vente.annuleePar ? ' par ' ~ vente.annuleePar.nom }} : {{ vente.motifAnnulation }}</div>
    {% endif %}

    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle mb-0" id="lignes">
                        <thead class="table-light">
                            <tr><th class="ps-3">Produit</th><th class="text-end">Qté</th><th class="text-end">Prix</th><th class="text-end">Remise</th><th class="text-end pe-3">Montant</th></tr>
                        </thead>
                        <tbody>
                            {% for ligne in vente.lignes %}
                                <tr>
                                    <td class="ps-3">
                                        {{ ligne.produit.nomCommercial }}
                                        {% if amo %}<span class="badge {{ ligne.remboursable ? 'text-bg-info' : 'text-bg-light border' }}">{{ ligne.remboursable ? 'Remboursable' : 'Non remboursable' }}</span>{% endif %}
                                        <div class="small text-body-secondary">
                                            {% for ll in ligne.lots %}Lot {{ ll.lot.numero }} ({{ ll.quantite }}, pér. {{ ll.lot.datePeremption|date('m/Y') }}){{ not loop.last ? ' · ' }}{% endfor %}
                                        </div>
                                    </td>
                                    <td class="text-end">{{ ligne.quantite }}</td>
                                    <td class="montant">{{ ligne.prixUnitaire|fcfa }}</td>
                                    <td class="montant">{{ ligne.remise > 0 ? '− ' ~ ligne.remise|fcfa : '—' }}</td>
                                    <td class="montant pe-3">{{ (ligne.montantBrut - ligne.remise)|fcfa }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <dl class="row mb-0" id="totaux">
                        <dt class="col-7 fw-normal">Total</dt><dd class="col-5 montant">{{ vente.totalBrut|fcfa }}</dd>
                        {% if amo %}
                            <dt class="col-7 fw-normal">Part AMO ({{ vente.organismeAmo.code }}, {{ vente.tauxAmo }} %)</dt><dd class="col-5 montant">{{ vente.partAmo|fcfa }}</dd>
                        {% endif %}
                        {% if vente.remise > 0 %}<dt class="col-7 fw-normal text-success">Remise</dt><dd class="col-5 montant text-success">− {{ vente.remise|fcfa }}</dd>{% endif %}
                        <dt class="col-7">Encaissé</dt><dd class="col-5 montant fw-bold" id="encaisse">{{ vente.montantEncaisse|fcfa }}</dd>
                        {% for paiement in vente.paiements %}
                            <dt class="col-7 fw-normal small text-body-secondary ps-3">{{ paiement.mode.libelle }}{{ paiement.reference ? ' (' ~ paiement.reference ~ ')' }}</dt><dd class="col-5 montant small">{{ paiement.montant|fcfa }}</dd>
                        {% endfor %}
                        {% if vente.monnaieRendue > 0 %}<dt class="col-7 fw-normal small text-body-secondary ps-3">Monnaie rendue</dt><dd class="col-5 montant small">{{ vente.monnaieRendue|fcfa }}</dd>{% endif %}
                        {% if is_granted('ROLE_ADJOINT') and vente.statut.value == 'validee' %}
                            <dt class="col-7 fw-normal small text-body-secondary">Marge brute</dt><dd class="col-5 montant small">{{ vente.marge|fcfa }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </div>
            <div class="card shadow-sm mb-3">
                <div class="card-body small">
                    <div><span class="text-body-secondary">Client :</span> {{ vente.client ? vente.client.nom : 'client de passage' }}</div>
                    {% if amo %}<div><span class="text-body-secondary">Assuré :</span> {{ vente.organismeAmo.code }} {{ vente.numeroAssure }}</div>{% endif %}
                    {% if vente.ordonnance %}
                        <div><span class="text-body-secondary">Ordonnance :</span> {{ vente.ordonnance.numero ? 'n° ' ~ vente.ordonnance.numero ~ ', ' }}du {{ vente.ordonnance.date|date('d/m/Y') }}, {{ vente.ordonnance.prescripteur }}{{ vente.ordonnance.structure ? ' (' ~ vente.ordonnance.structure ~ ')' }}</div>
                    {% endif %}
                    {% if vente.autorisePar %}<div><span class="text-body-secondary">Autorisée par :</span> {{ vente.autorisePar.nom }}</div>{% endif %}
                </div>
            </div>
            {% if is_granted('ROLE_ADJOINT') and vente.statut.value == 'validee' and ecriture_autorisee() %}
                <form method="post" action="{{ path('app_vente_annuler', {id: vente.id}) }}" class="card shadow-sm border-danger" id="annulation">
                    <input type="hidden" name="_token" value="{{ csrf_token('annuler-vente-' ~ vente.id) }}">
                    <div class="card-body">
                        <label class="form-label small" for="motif">Motif de l'annulation</label>
                        <input type="text" class="form-control form-control-sm mb-2" id="motif" name="motif" maxlength="255" required>
                        <button class="btn btn-sm btn-outline-danger" type="submit" data-turbo-confirm="Annuler la vente {{ vente.numero }} ? Les produits reviendront en stock.">Annuler la vente</button>
                        <div class="form-text">Possible le jour même, avant la clôture de la caisse ; ensuite il faut un avoir.</div>
                    </div>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
