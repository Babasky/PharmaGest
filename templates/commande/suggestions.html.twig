{% extends 'layout/app.html.twig' %}

{% block title %}Suggestions de commande{% endblock %}

{% block page_actions %}
    <a class="btn btn-outline-secondary" href="{{ path('app_commande_index') }}"><i class="bi bi-arrow-left"></i> Commandes</a>
{% endblock %}

{% block content %}
    {% set selon_jour = base == 'jour' %}
    {% set parametres_base = {base: base, date: jour|date('Y-m-d')} %}
    <ul class="nav nav-tabs mb-3" id="bases-suggestion">
        <li class="nav-item"><a class="nav-link{{ selon_jour ? '' : ' active' }}" href="{{ path('app_commande_suggestions') }}"><i class="bi bi-graph-up-arrow"></i> Selon les tendances de vente</a></li>
        <li class="nav-item"><a class="nav-link{{ selon_jour ? ' active' }}" href="{{ path('app_commande_suggestions', {base: 'jour'}) }}"><i class="bi bi-calendar-day"></i> Selon les ventes du jour</a></li>
    </ul>

    {% if selon_jour %}
        <form method="get" class="d-flex flex-wrap align-items-end gap-2 mb-2" id="choix-jour">
            <input type="hidden" name="base" value="jour">
            <div>
                <label class="form-label small mb-1" for="date-ventes">Ventes du</label>
                <input class="form-control form-control-sm" type="date" id="date-ventes" name="date" value="{{ jour|date('Y-m-d') }}" max="{{ aujourdhui|date('Y-m-d') }}">
            </div>
            <button class="btn btn-sm btn-outline-secondary" type="submit">Afficher</button>
        </form>
        <p class="text-body-secondary small">
            Chaque produit vendu le {{ jour|date('d/m/Y') }} est recommandé dans la quantité vendue (ventes moins annulations et retours),
            sans dépasser son stock maximum en comptant ce qui est déjà commandé.
        </p>
    {% else %}
        <p class="text-body-secondary small">
            Produits sous le seuil d'alerte, ou dont le stock atteindra le seuil avant qu'une commande passée aujourd'hui soit livrée.
            Quantité proposée : seuil d'alerte + ventes moyennes par jour × (délai de livraison du fournisseur + jours de couverture),
            moins le stock et ce qui est déjà commandé, sans dépasser le stock maximum. Sans vente récente : stock maximum − stock
            (ou le double du seuil). Le fournisseur est le fournisseur habituel, à défaut celui de la dernière commande du produit.
            {% if is_granted('ROLE_PROPRIETAIRE') %}<a href="{{ path('app_parametres', {onglet: 'regles'}) }}">Régler la période d'analyse et la couverture</a>.{% endif %}
        </p>
    {% endif %}

    {% if groupes is empty %}
        <div class="alert alert-success" id="aucune-suggestion"><i class="bi bi-check-circle"></i>
            {{ selon_jour ? 'Aucune vente ce jour-là : rien à recommander.' : 'Aucun produit à commander pour l\'instant.' }}
        </div>
    {% else %}
        {% if a_transmettre is not empty and ecriture_autorisee() %}
            <div class="card shadow-sm mb-3" id="transmission">
                <div class="card-body d-flex flex-wrap align-items-center gap-2">
                    <div class="me-auto small">
                        <strong>{{ a_transmettre|length }} grossiste(s)</strong> à commander :
                        {% for f in a_transmettre %}{{ f.nom }}{{ f.email ? '' : ' (sans email)' }}{{ loop.last ? '' : ', ' }}{% endfor %}
                    </div>
                    <form method="post" action="{{ path('app_commande_preparer') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token(csrf_suggestions) }}">
                        {% for nom, valeur in parametres_base %}<input type="hidden" name="{{ nom }}" value="{{ valeur }}">{% endfor %}
                        <button class="btn btn-outline-success" type="submit"><i class="bi bi-files"></i> Préparer toutes les commandes</button>
                    </form>
                    {% if is_granted('ROLE_ADJOINT') %}
                        {% set noms = a_transmettre|filter(f => f.email)|map(f => f.nom)|join(', ') %}
                        <form method="post" action="{{ path('app_commande_transmettre') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token(csrf_suggestions) }}">
                            {% for nom, valeur in parametres_base %}<input type="hidden" name="{{ nom }}" value="{{ valeur }}">{% endfor %}
                            <button class="btn btn-success" type="submit" data-turbo-confirm="Envoyer maintenant par email les commandes suggérées{{ noms ? ' à ' ~ noms }} ? Elles recevront leur numéro et ne seront plus modifiables. Les grossistes sans email gardent un brouillon."><i class="bi bi-send"></i> Envoyer aux grossistes</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <ul class="nav nav-pills mb-3" id="fournisseurs-suggeres">
            {% for cle, groupe in groupes %}
                {% set actif = groupe.fournisseur ? (fournisseur and fournisseur.id == groupe.fournisseur.id) : sans_fournisseur %}
                <li class="nav-item">
                    <a class="nav-link{{ actif ? ' active' }}" href="{{ path('app_commande_suggestions', parametres_base|merge({fournisseur: cle})) }}">
                        {{ groupe.fournisseur ? groupe.fournisseur.nom : 'Sans fournisseur' }} <span class="badge text-bg-light">{{ groupe.nombre }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>

        {% if sans_fournisseur %}
            <div class="alert alert-info small">Ces produits n'ont ni fournisseur habituel actif ni commande récente : renseignez leur fournisseur habituel sur leur fiche, ou ajoutez-les à une commande à la main.</div>
            <div class="card shadow-sm">
                <ul class="list-group list-group-flush" id="suggestions">
                    {% for s in suggestions %}
                        <li class="list-group-item d-flex justify-content-between">
                            <a class="text-decoration-none" href="{{ path('app_produit_voir', {id: s.produit.id}) }}">{{ s.produit.designation }}</a>
                            <span class="small text-body-secondary">stock {{ s.stock }} · seuil {{ s.produit.seuilAlerte }}{{ s.vendu ? ' · vendu ' ~ s.vendu }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% elseif fournisseur %}
            <form method="post" action="{{ path('app_commande_depuis_suggestions') }}" id="formulaire-suggestions">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_suggestions) }}">
                <input type="hidden" name="fournisseur" value="{{ fournisseur.id }}">
                {% for nom, valeur in parametres_base %}<input type="hidden" name="{{ nom }}" value="{{ valeur }}">{% endfor %}
                <p class="small text-body-secondary mb-2">Délai de livraison de {{ fournisseur.nom }} : {{ fournisseur.delaiLivraison ?? constant('App\\Achat\\SuggestionsCommande::DELAI_LIVRAISON_PAR_DEFAUT') }} jour(s){{ fournisseur.delaiLivraison is null ? ' (par défaut, à préciser sur sa fiche)' }}.
                    {% if fournisseur.heureCommande is not null %}
                        {% set noms_jours = {1: 'lun', 2: 'mar', 3: 'mer', 4: 'jeu', 5: 'ven', 6: 'sam', 7: 'dim'} %}
                        Commande automatique à {{ fournisseur.heureCommande }} h, {{ fournisseur.joursCommande is empty ? 'tous les jours' : fournisseur.joursCommande|map(j => noms_jours[j])|join(', ') }}.
                    {% endif %}
                </p>
                <div class="card shadow-sm mb-3">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0" id="suggestions">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3" style="width: 2rem"></th><th>Produit</th>
                                    {% if selon_jour %}
                                        <th class="text-end">Vendu ce jour</th>
                                    {% else %}
                                        <th>Rotation</th><th class="text-end">Ventes / jour</th><th class="text-end">Couverture</th>
                                    {% endif %}
                                    <th class="text-end">Stock</th><th class="text-end">Seuil</th><th class="text-end">Stock max.</th><th class="text-end">Déjà commandé</th><th>Dernier achat</th><th class="text-end pe-3">À commander</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for s in suggestions %}
                                    {% set p = s.produit %}
                                    <tr data-produit="{{ p.nomCommercial }}">
                                        <td class="ps-3"><input class="form-check-input" type="checkbox" name="produits[]" value="{{ p.id }}" id="produit-{{ p.id }}"{{ s.quantite > 0 ? ' checked' }} aria-label="Commander {{ p.nomCommercial }}"></td>
                                        <td>
                                            <label for="produit-{{ p.id }}">{{ p.designation }}</label>
                                            {% if s.stock == 0 %} <span class="badge text-bg-danger">rupture</span>{% elseif not selon_jour %} <span class="badge text-bg-light">{{ s.motif|lower }}</span>{% endif %}
                                            {% if s.inhabituelle %} <span class="badge text-bg-warning" title="Plus de {{ constant('App\\Achat\\SuggestionsCommande::FACTEUR_INHABITUEL') }} fois le dernier achat : à vérifier. Une commande automatique qui la contient reste en brouillon.">quantité inhabituelle</span>{% endif %}
                                        </td>
                                        {% if selon_jour %}
                                            <td class="text-end">{{ s.vendu }}</td>
                                        {% else %}
                                            <td><span class="badge text-bg-{{ s.rotation.couleur }}">{{ s.rotation.libelle }}</span></td>
                                            <td class="text-end">{{ s.moyenne ? s.moyenne|number_format(1, ',', ' ') : '—' }}</td>
                                            <td class="text-end">{{ s.couverture is not null ? s.couverture|round(0, 'floor') ~ ' j' : '—' }}</td>
                                        {% endif %}
                                        <td class="text-end">{{ s.stock }}</td>
                                        <td class="text-end">{{ p.seuilAlerte }}</td>
                                        <td class="text-end">{{ p.stockMax ?? '—' }}</td>
                                        <td class="text-end">{{ s.attendu ?: '—' }}</td>
                                        <td class="small text-body-secondary">{{ s.dernier_achat ? s.dernier_achat.quantite ~ ' le ' ~ s.dernier_achat.date|date('d/m/Y') : '—' }}</td>
                                        <td class="pe-3"><input type="number" min="0" max="100000" class="form-control form-control-sm text-end ms-auto" style="max-width: 7rem" name="quantite[{{ p.id }}]" value="{{ s.quantite }}" aria-label="Quantité de {{ p.nomCommercial }}"></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% if ecriture_autorisee() %}
                    <button class="btn btn-success" type="submit"><i class="bi bi-cart-check"></i> Créer la commande pour {{ fournisseur.nom }}</button>
                {% endif %}
            </form>
        {% endif %}
    {% endif %}
{% endblock %}
