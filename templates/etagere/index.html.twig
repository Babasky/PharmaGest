{% extends 'layout/app.html.twig' %}

{% block title %}Étagères{% endblock %}

{% block content %}
    <div class="row g-3">
        <div class="col-12 col-lg-7 order-2 order-lg-1">
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light"><tr><th class="ps-3">Code</th><th>Libellé</th><th>Zone</th><th class="pe-3"><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                            {% for etagere in etageres %}
                                <tr class="{{ etagere.actif ? '' : 'text-body-secondary' }}">
                                    <td class="ps-3 fw-semibold text-nowrap">{{ etagere.code }}{% if not etagere.actif %} <span class="badge text-bg-secondary">Archivée</span>{% endif %}</td>
                                    <td>{{ etagere.libelle }}</td>
                                    <td><i class="bi bi-{{ {comptoir: 'shop', reserve: 'box-seam', refrigerateur: 'snow'}[etagere.zone.value] }}"></i> {{ etagere.zone.libelle }}</td>
                                    <td class="pe-3 text-end text-nowrap">
                                        {% if ecriture_autorisee() %}
                                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_etagere_modifier', {id: etagere.id}) }}" title="Modifier"><i class="bi bi-pencil"></i><span class="visually-hidden">Modifier {{ etagere.code }}</span></a>
                                            <form method="post" action="{{ path('app_etagere_archiver', {id: etagere.id}) }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('archiver-' ~ etagere.id) }}">
                                                <button class="btn btn-sm btn-outline-{{ etagere.actif ? 'danger' : 'success' }}" title="{{ etagere.actif ? 'Archiver' : 'Restaurer' }}"><i class="bi bi-{{ etagere.actif ? 'archive' : 'arrow-counterclockwise' }}"></i><span class="visually-hidden">{{ etagere.actif ? 'Archiver' : 'Restaurer' }}</span></button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="4" class="text-center text-body-secondary py-4">Aucune étagère. Donnez à chaque rayon un code court (ex. E1-R3) : il s'affichera à la caisse.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {% if ecriture_autorisee() %}
            <div class="col-12 col-lg-5 order-1 order-lg-2">
                <div class="card shadow-sm">
                    <div class="card-header bg-body fw-semibold">Nouvelle étagère</div>
                    <div class="card-body">
                        {{ form_start(formulaire) }}
                        {{ form_widget(formulaire) }}
                        <button class="btn btn-success" type="submit">Créer</button>
                        {{ form_end(formulaire) }}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
