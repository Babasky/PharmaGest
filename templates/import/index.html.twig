{% extends 'layout/app.html.twig' %}

{% block title %}Importer des {{ definition.libelle|lower }}{% endblock %}

{% block page_actions %}
    <a class="btn btn-outline-secondary" href="{{ path(retour) }}"><i class="bi bi-arrow-left"></i> Retour</a>
{% endblock %}

{% block content %}
    {% if rapport is null %}
        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <ol class="small mb-3 ps-3">
                            <li>Téléchargez le <a href="{{ path('app_import_modele', {type: definition.code}) }}">fichier modèle Excel</a> (ou utilisez votre fichier : les colonnes sont reconnues par leur titre).</li>
                            <li>Remplissez une ligne par {{ definition.libelle|lower|slice(0, -1) }}.</li>
                            <li>Déposez le fichier : PharmaGest le vérifie <strong>sans rien enregistrer</strong> et vous montre les erreurs ligne par ligne.</li>
                            <li>Confirmez pour importer les lignes valides.</li>
                        </ol>
                        {% if erreur %}<div class="alert alert-danger py-2">{{ erreur }}</div>{% endif %}
                        {# L'analyse affiche un rapport (pas de redirection) : envoi classique, hors Turbo. #}
                        <form method="post" enctype="multipart/form-data" class="d-grid gap-2" data-turbo="false">
                            <input type="hidden" name="_token" value="{{ csrf_token('import-' ~ definition.code) }}">
                            <label for="fichier" class="form-label mb-0">Fichier Excel (.xlsx) ou CSV, 2 Mo maximum</label>
                            <input type="file" class="form-control" id="fichier" name="fichier" accept=".xlsx,.xls,.csv" required>
                            <button class="btn btn-success" type="submit"><i class="bi bi-search"></i> Vérifier le fichier</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-body fw-semibold">Colonnes</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small">
                            <tbody>
                                {% for colonne in definition.colonnes %}
                                    <tr>
                                        <td class="ps-3 text-nowrap fw-semibold">{{ colonne.entete }}{% if colonne.obligatoire %} <span class="text-danger" title="Obligatoire">*</span>{% endif %}</td>
                                        <td class="pe-3 text-body-secondary">{{ colonne.aide }}{% if colonne.exemple %} <span class="text-nowrap">Ex. : {{ colonne.exemple }}</span>{% endif %}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        {% for message in rapport.erreursFichier %}
            <div class="alert alert-danger"><i class="bi bi-x-octagon"></i> {{ message }}</div>
        {% endfor %}

        {% if rapport.erreursFichier is empty %}
            <div class="row g-3 mb-3">
                {% for statut, info in {creation: ['À créer', 'plus-circle', 'success'], mise_a_jour: ['À mettre à jour', 'arrow-repeat', 'info'], erreur: ['En erreur (ignorées)', 'exclamation-triangle', 'danger']} %}
                    <div class="col-12 col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body d-flex align-items-center gap-3">
                                <i class="bi bi-{{ info[1] }} fs-3 text-{{ info[2] }}"></i>
                                <div><div class="small text-body-secondary">{{ info[0] }}</div><div class="fs-4 fw-semibold">{{ rapport.compter(statut) }}</div></div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {% if rapport.lignesEnErreur is not empty %}
                <div class="card shadow-sm mb-3 border-danger-subtle">
                    <div class="card-header bg-body fw-semibold text-danger">Lignes à corriger</div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light"><tr><th class="ps-3">Ligne</th><th>Élément</th><th class="pe-3">Problème</th></tr></thead>
                            <tbody>
                                {% for ligne in rapport.lignesEnErreur %}
                                    <tr>
                                        <td class="ps-3">{{ ligne.numero }}</td>
                                        <td>{{ ligne.libelle }}</td>
                                        <td class="pe-3"><ul class="mb-0 ps-3 small">{% for m in ligne.messages %}<li>{{ m }}</li>{% endfor %}</ul></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}

            {% set remarques = rapport.lignes|filter(l => not l.enErreur and l.messages is not empty) %}
            {% if remarques is not empty %}
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-body fw-semibold">Éléments créés au passage</div>
                    <ul class="list-group list-group-flush small">
                        {% for ligne in remarques %}<li class="list-group-item">Ligne {{ ligne.numero }} : {{ ligne.messages|join(' ') }}</li>{% endfor %}
                    </ul>
                </div>
            {% endif %}
        {% endif %}

        <div class="d-flex flex-wrap gap-2">
            {% if rapport.estUtilisable %}
                <form method="post" action="{{ path('app_import_confirmer', {type: definition.code}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('import-' ~ definition.code) }}">
                    <input type="hidden" name="fichier" value="{{ fichier }}">
                    <button class="btn btn-success" type="submit"><i class="bi bi-check2-circle"></i> Importer les {{ rapport.nombreValides }} ligne{{ rapport.nombreValides > 1 ? 's' }} valide{{ rapport.nombreValides > 1 ? 's' }}</button>
                </form>
            {% endif %}
            <a class="btn btn-outline-secondary" href="{{ path('app_import', {type: definition.code}) }}">Déposer un autre fichier</a>
        </div>
    {% endif %}
{% endblock %}
