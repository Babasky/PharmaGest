{% extends 'layout/app.html.twig' %}

{% block title %}Accord demandé{% endblock %}

{% block page_actions %}
    <a class="btn btn-outline-secondary" href="{{ path('app_accord_index') }}"><i class="bi bi-arrow-left"></i> Demandes</a>
{% endblock %}

{% block content %}
    {% set demandeur = vente.accordDemandePar ? vente.accordDemandePar.nom : vente.vendeur.nom %}
    <div class="row g-3">
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm" id="panier-accord">
                <div class="card-header fw-semibold">
                    Panier de {{ demandeur }} · {{ vente.type.libelle }}{{ vente.client ? ' · ' ~ vente.client.nom }}
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light"><tr><th class="ps-3">Produit</th><th class="text-end">Qté</th><th class="text-end">Prix</th><th class="text-end pe-3">Remise</th></tr></thead>
                        <tbody>
                            {% for ligne in vente.lignes %}
                                <tr>
                                    <td class="ps-3">{{ ligne.produit.nomCommercial }}{% if ligne.produit.ordonnanceObligatoire %} <span class="badge text-bg-warning">Ordonnance obligatoire</span>{% endif %}</td>
                                    <td class="text-end">{{ ligne.quantite }}</td>
                                    <td class="montant">{{ ligne.prixUnitaire|fcfa }}</td>
                                    <td class="montant pe-3">{{ ligne.remise > 0 ? '− ' ~ ligne.remise|fcfa : '—' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <span>À payer</span><strong>{{ totaux.aEncaisser|fcfa }}</strong>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm" id="reponse-accord">
                <div class="card-body">
                    <p class="small text-body-secondary mb-2">Demandé par {{ demandeur }} le {{ vente.accordDemandeLe|date('d/m/Y à H:i') }}.</p>
                    {% if controle %}
                        {% for message in controle.autorisations %}<div class="alert alert-warning py-2 small mb-2"><i class="bi bi-shield-lock"></i> {{ message }}</div>{% endfor %}
                        <form method="post" action="{{ path('app_accord_repondre', {id: vente.id}) }}" class="d-flex gap-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('accord-' ~ vente.id) }}">
                            <button class="btn btn-success flex-grow-1" type="submit" name="reponse" value="donner"><i class="bi bi-check-lg"></i> Donner mon accord</button>
                            <button class="btn btn-outline-danger" type="submit" name="reponse" value="refuser"><i class="bi bi-x-lg"></i> Refuser</button>
                        </form>
                    {% elseif vente.accordReponduLe %}
                        <div class="alert alert-{{ vente.accordValide ? 'success' : 'secondary' }} mb-0">
                            Demande {{ vente.accordValide ? 'acceptée' : 'traitée' }} par {{ vente.accordReponduPar ? vente.accordReponduPar.nom : '—' }} le {{ vente.accordReponduLe|date('d/m/Y à H:i') }}.
                        </div>
                    {% else %}
                        <div class="alert alert-secondary mb-0">Le panier a changé ou la vente est terminée : cette demande n'est plus valable.</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
