{# Tableau de rapport (App\Reporting\Tableau), à l'écran. #}
<div class="card shadow-sm mb-3" id="tableau-{{ tableau.id }}">
    <div class="card-header bg-body fw-semibold">{{ tableau.titre }}</div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    {% for libelle, type in tableau.colonnes %}
                        <th class="{{ loop.first ? 'ps-3' }}{{ loop.last ? ' pe-3' }}{{ type not in ['texte', 'date'] ? ' text-end' }}">{{ libelle }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for ligne in tableau.lignes %}
                    {% set n = loop.index0 %}
                    <tr>
                        {% for valeur in ligne %}
                            {% set type = tableau.type(n, loop.index0) %}
                            <td class="{{ loop.first ? 'ps-3' }}{{ loop.last ? ' pe-3' }}{{ type not in ['texte', 'date'] ? ' text-end text-nowrap' }}">
                                {{ valeur|cellule(type) }}
                            </td>
                        {% endfor %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ tableau.colonnes|length }}" class="text-center text-body-secondary py-3">
                            Aucune donnée sur la période.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            {% if tableau.total and tableau.lignes is not empty %}
                <tfoot class="table-light fw-semibold">
                    <tr>
                        {% for valeur in tableau.total %}
                            {% set type = tableau.types[loop.index0] %}
                            <td class="{{ loop.first ? 'ps-3' }}{{ loop.last ? ' pe-3' }}{{ type not in ['texte', 'date'] ? ' text-end text-nowrap' }}">
                                {{ valeur is null ? '' : valeur|cellule(type) }}
                            </td>
                        {% endfor %}
                    </tr>
                </tfoot>
            {% endif %}
        </table>
    </div>
    {% if tableau.note %}
        <div class="card-footer bg-body small text-body-secondary">{{ tableau.note }}</div>
    {% endif %}
</div>
