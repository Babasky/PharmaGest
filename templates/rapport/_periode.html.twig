{# Filtre de période (RA-01). Paramètres : periode (App\Reporting\Periode), route, params (autres filtres à garder). #}
{% set params = params|default({}) %}
{% set types = constant('App\\Reporting\\Periode::TYPES') %}
<form method="get" action="{{ path(route, route_params|default({})) }}" class="card shadow-sm mb-3" id="filtre-periode">
    <div class="card-body d-flex flex-wrap align-items-end gap-2">
        {% for nom, valeur in params|filter(v => v is not null and v != '') %}<input type="hidden" name="{{ nom }}" value="{{ valeur }}">{% endfor %}
        <div>
            <label class="form-label small mb-1" for="periode-type">Période</label>
            <select class="form-select" id="periode-type" name="periode">
                {% for code, libelle in types %}<option value="{{ code }}"{{ periode.type == code ? ' selected' }}>{{ libelle }}</option>{% endfor %}
            </select>
        </div>
        <div>
            <label class="form-label small mb-1" for="periode-date">Date (jour à mois)</label>
            <input class="form-control" type="date" id="periode-date" name="date" value="{{ periode.debut|date('Y-m-d') }}">
        </div>
        <div>
            <label class="form-label small mb-1" for="periode-du">Plage libre : du</label>
            <input class="form-control" type="date" id="periode-du" name="du" value="{{ periode.type == 'libre' ? periode.debut|date('Y-m-d') }}">
        </div>
        <div>
            <label class="form-label small mb-1" for="periode-au">au</label>
            <input class="form-control" type="date" id="periode-au" name="au" value="{{ periode.type == 'libre' ? periode.fin|date('Y-m-d') }}">
        </div>
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-funnel"></i> Afficher</button>
        <div class="ms-auto d-flex align-items-center gap-2">
            <a class="btn btn-sm btn-outline-secondary" href="{{ path(route, (route_params|default({}))|merge(params)|merge(periode.precedente.parametres)) }}" aria-label="Période précédente"><i class="bi bi-chevron-left"></i></a>
            <span class="fw-semibold" id="periode-libelle">{{ periode.libelle }}</span>
            <a class="btn btn-sm btn-outline-secondary" href="{{ path(route, (route_params|default({}))|merge(params)|merge(periode.suivante.parametres)) }}" aria-label="Période suivante"><i class="bi bi-chevron-right"></i></a>
        </div>
    </div>
</form>
