{% extends 'layout/app.html.twig' %}

{% block title %}Bordereau {{ bordereau.libelle }}{% endblock %}

{% block page_actions %}
    <a class="btn btn-outline-secondary" href="{{ path('app_amo_bordereaux') }}"><i class="bi bi-arrow-left"></i> Bordereaux</a>
    <a class="btn btn-outline-success" href="{{ path('app_amo_bordereau_excel', {id: bordereau.id}) }}"><i class="bi bi-file-earmark-excel"></i> Excel</a>
    <a class="btn btn-outline-success" href="{{ path('app_amo_bordereau_pdf', {id: bordereau.id}) }}" target="_blank"><i class="bi bi-file-earmark-pdf"></i> PDF avec ordonnances</a>
{% endblock %}

{% block content %}
    {% set jeton = csrf_token('bordereau-' ~ bordereau.id) %}
    {% set ecriture = ecriture_autorisee() %}
    <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
        <span class="badge fs-6 text-bg-{{ bordereau.statut.couleur }}" id="statut">{{ bordereau.statut.libelle }}</span>
        <span class="fw-semibold">{{ bordereau.organisme.nom }} ({{ bordereau.organisme.code }})</span>
        <span>Ventes du {{ bordereau.debut|date('d/m/Y') }} au {{ bordereau.fin|date('d/m/Y') }}</span>
        <span class="small text-body-secondary">
            Créé le {{ bordereau.creeLe|date('d/m/Y') }}{{ bordereau.creePar ? ' par ' ~ bordereau.creePar.nom }}
            {% if bordereau.transmisLe %} · transmis le {{ bordereau.transmisLe|date('d/m/Y') }}{{ bordereau.transmisPar ? ' par ' ~ bordereau.transmisPar.nom }}{% endif %}
        </span>
    </div>

    {% if sans_copie > 0 %}
        <div class="alert alert-warning small" id="alerte-copies"><i class="bi bi-camera"></i> {{ sans_copie }} ordonnance{{ sans_copie > 1 ? 's' }} sans copie : ajoutez la photo depuis la fiche de la vente pour qu'elle figure en annexe du PDF.</div>
    {% endif %}

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3"><div class="card shadow-sm"><div class="card-body py-2"><div class="small text-body-secondary">Montant</div><div class="fs-5 fw-bold" id="montant">{{ bordereau.montant|fcfa }}</div><div class="small text-body-secondary">{{ bordereau.creances|length }} créance(s)</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card shadow-sm"><div class="card-body py-2"><div class="small text-body-secondary">Réglé</div><div class="fs-5 fw-bold text-success" id="regle">{{ bordereau.montantRegle|fcfa }}</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card shadow-sm"><div class="card-body py-2"><div class="small text-body-secondary">Rejeté</div><div class="fs-5 fw-bold text-danger" id="rejete">{{ bordereau.montantRejete|fcfa }}</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card shadow-sm"><div class="card-body py-2"><div class="small text-body-secondary">Reste attendu</div><div class="fs-5 fw-bold" id="reste">{{ bordereau.reste|fcfa }}</div></div></div></div>
    </div>

    {% set reglable = bordereau.estTransmis and not bordereau.estSolde and ecriture %}
    {% if reglable %}<form method="post" action="{{ path('app_amo_bordereau_reglement', {id: bordereau.id}) }}" id="reglement">{% endif %}
    <div class="card shadow-sm mb-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="creances">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Vente</th><th>Assuré</th><th>Ordonnance</th><th class="text-end">Part AMO</th>
                        {% if bordereau.estTransmis %}<th class="text-end">Réglé</th><th>Statut</th>{% endif %}
                        {% if reglable %}<th class="text-end">Montant réglé</th><th class="pe-3">Motif de rejet</th>{% endif %}
                        {% if bordereau.estBrouillon and ecriture %}<th class="pe-3"></th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for creance in bordereau.creances %}
                        {% set vente = creance.vente %}
                        {% set ord = vente.ordonnance %}
                        <tr data-vente="{{ vente.numero }}">
                            <td class="ps-3"><a class="font-monospace text-decoration-none" href="{{ path('app_vente_voir', {id: vente.id}) }}">{{ vente.numero }}</a><div class="small text-body-secondary">{{ creance.dateVente|date('d/m/Y') }}</div></td>
                            <td>{{ vente.client ? vente.client.nom }}<div class="small text-body-secondary">{{ vente.numeroAssure }}</div></td>
                            <td class="small">
                                {% if ord %}{{ ord.date ? ord.date|date('d/m/Y') }} · {{ ord.prescripteur }}{% endif %}
                                {% if ord and ord.copie %}<i class="bi bi-camera text-success" title="Copie jointe"></i>{% else %}<span class="badge text-bg-warning">sans copie</span>{% endif %}
                            </td>
                            <td class="montant">{{ creance.montant|fcfa }}</td>
                            {% if bordereau.estTransmis %}
                                <td class="montant">{{ creance.montantRegle|fcfa }}</td>
                                <td><span class="badge text-bg-{{ creance.statut.couleur }}">{{ creance.statut.libelle }}</span>{% if creance.motifRejet %}<div class="small text-danger">{{ creance.motifRejet }}</div>{% endif %}</td>
                            {% endif %}
                            {% if reglable %}
                                {% if creance.reste > 0 %}
                                    <td><input type="text" inputmode="numeric" class="form-control form-control-sm text-end" name="regle[{{ creance.id }}]" value="{{ creance.reste }}" style="min-width: 7rem" aria-label="Montant réglé pour {{ vente.numero }}"></td>
                                    <td class="pe-3"><input type="text" class="form-control form-control-sm" name="rejet[{{ creance.id }}]" maxlength="255" placeholder="Rejet du reste…" aria-label="Motif de rejet pour {{ vente.numero }}"></td>
                                {% else %}
                                    <td></td><td class="pe-3"></td>
                                {% endif %}
                            {% endif %}
                            {% if bordereau.estBrouillon and ecriture %}
                                <td class="pe-3 text-end">
                                    <form method="post" action="{{ path('app_amo_bordereau_retirer', {id: bordereau.id, creance: creance.id}) }}">
                                        <input type="hidden" name="_token" value="{{ jeton }}">
                                        <button class="btn btn-sm btn-outline-secondary" type="submit" title="Retirer du bordereau"><i class="bi bi-x-lg"></i></button>
                                    </form>
                                </td>
                            {% endif %}
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="text-center text-body-secondary py-4">Aucune créance sur ce brouillon.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% if reglable %}
        <div class="card shadow-sm border-success mb-3">
            <div class="card-header bg-body fw-semibold">Enregistrer un règlement</div>
            <div class="card-body">
                <input type="hidden" name="_token" value="{{ jeton }}">
                <div class="row g-2 align-items-end">
                    <div class="col-6 col-md-3"><label class="form-label small" for="date-reglement">Reçu le</label><input type="date" class="form-control" id="date-reglement" name="date" value="{{ aujourdhui|date('Y-m-d') }}" max="{{ aujourdhui|date('Y-m-d') }}" required></div>
                    <div class="col-6 col-md-3"><label class="form-label small" for="montant-recu">Montant reçu (FCFA)</label><input type="text" inputmode="numeric" class="form-control text-end" id="montant-recu" name="montant" value="{{ bordereau.reste }}" required></div>
                    <div class="col-12 col-md-3"><label class="form-label small" for="reference">Référence (virement, chèque)</label><input type="text" class="form-control" id="reference" name="reference" maxlength="80"></div>
                    <div class="col-12 col-md-3"><button class="btn btn-success w-100" type="submit">Enregistrer</button></div>
                </div>
                <p class="form-text mb-0">Affectez le montant reçu créance par créance : le total affecté doit être égal au montant reçu. Un motif de rejet solde la créance : son reste ne sera plus attendu.</p>
            </div>
        </div>
    </form>
    {% endif %}

    {% if bordereau.reglements is not empty %}
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-body fw-semibold">Règlements reçus</div>
            <ul class="list-group list-group-flush" id="reglements">
                {% for reglement in bordereau.reglements %}
                    <li class="list-group-item d-flex justify-content-between">
                        <span>{{ reglement.date|date('d/m/Y') }}{{ reglement.reference ? ' · ' ~ reglement.reference }} <span class="small text-body-secondary">({{ reglement.affectations|length }} créance(s){{ reglement.enregistrePar ? ', saisi par ' ~ reglement.enregistrePar.nom }})</span></span>
                        <span class="montant fw-semibold">{{ reglement.montant|fcfa }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if ecriture and bordereau.estBrouillon %}
        <div class="d-flex flex-wrap gap-2">
            <form method="post" action="{{ path('app_amo_bordereau_transmettre', {id: bordereau.id}) }}">
                <input type="hidden" name="_token" value="{{ jeton }}">
                <button class="btn btn-success" type="submit" data-turbo-confirm="Transmettre ce bordereau ? Il recevra son numéro et ne sera plus modifiable."><i class="bi bi-send"></i> Transmettre</button>
            </form>
            <form method="post" action="{{ path('app_amo_bordereau_actualiser', {id: bordereau.id}) }}">
                <input type="hidden" name="_token" value="{{ jeton }}">
                <button class="btn btn-outline-success" type="submit"><i class="bi bi-arrow-clockwise"></i> Ajouter les nouvelles créances de la période</button>
            </form>
            <form method="post" action="{{ path('app_amo_bordereau_supprimer', {id: bordereau.id}) }}" class="ms-auto">
                <input type="hidden" name="_token" value="{{ jeton }}">
                <button class="btn btn-outline-danger" type="submit" data-turbo-confirm="Supprimer ce brouillon ? Ses créances redeviendront disponibles."><i class="bi bi-trash"></i> Supprimer le brouillon</button>
            </form>
        </div>
    {% elseif reglable %}
        <form method="post" action="{{ path('app_amo_bordereau_rejeter', {id: bordereau.id}) }}" class="card shadow-sm border-danger" id="rejet-bordereau">
            <input type="hidden" name="_token" value="{{ jeton }}">
            <div class="card-body">
                <label class="form-label small" for="motif-rejet">Rejet de tout le reste du bordereau</label>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control" id="motif-rejet" name="motif" maxlength="255" required placeholder="Motif communiqué par l'organisme">
                    <button class="btn btn-outline-danger" type="submit" data-turbo-confirm="Rejeter tout ce qui reste dû ({{ bordereau.reste|fcfa }}) ?">Rejeter</button>
                </div>
            </div>
        </form>
    {% endif %}
{% endblock %}
