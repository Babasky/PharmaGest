{% extends 'layout/public.html.twig' %}

{% block title %}Accès suspendu{% endblock %}

{% block content %}
    <p>
        {% if etat.statut.value == 'archive' %}
            Le compte de <strong>{{ pharmacie.nom }}</strong> est archivé depuis le {{ pharmacie.archiveeLe|date('d/m/Y') }}.
        {% else %}
            L'accès de <strong>{{ pharmacie.nom }}</strong> à SoftPharm est suspendu.
        {% endif %}
    </p>
    <p class="mb-2">Pour le rétablir, contactez l'éditeur, {{ editeur.nom }} :</p>
    <div class="mb-4">{{ include('support/_canaux.html.twig', {support: support_client(), pharmacie: pharmacie}) }}</div>
    <a class="btn btn-outline-secondary w-100" href="{{ logout_path() }}"><i class="bi bi-box-arrow-right"></i> Se déconnecter</a>
{% endblock %}
