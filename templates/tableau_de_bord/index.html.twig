{% extends 'layout/app.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block page_actions %}
    {% if is_granted('ROLE_ADJOINT') %}
        <a class="btn btn-outline-secondary" href="{{ path('app_rapport_index') }}"><i class="bi bi-bar-chart-line"></i> Rapports</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="row g-3 mb-4" id="indicateurs">
        {% for indicateur in indicateurs %}
            <div class="col-6 col-xl-3">
                <div class="card h-100 shadow-sm" id="indicateur-{{ indicateur.id }}">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="bi bi-{{ indicateur.icone }} fs-2 text-success"></i>
                        <div class="min-w-0">
                            <div class="small text-body-secondary">
                                {% if indicateur.lien is defined %}
                                    <a class="stretched-link text-reset text-decoration-none" href="{{ path('app_stock_alertes', indicateur.lien) }}">{{ indicateur.libelle }}</a>
                                {% elseif indicateur.route is defined %}
                                    <a class="stretched-link text-reset text-decoration-none" href="{{ path(indicateur.route) }}">{{ indicateur.libelle }}</a>
                                {% else %}{{ indicateur.libelle }}{% endif %}
                            </div>
                            <div class="fs-5 fw-semibold text-nowrap valeur">
                                {{ indicateur.montant ? indicateur.valeur|fcfa : indicateur.valeur|number_format(0, ',', ' ') }}
                            </div>
                            {% if indicateur.evolution is defined %}
                                {% if indicateur.evolution is null %}
                                    <div class="small text-body-secondary">mois précédent : —</div>
                                {% else %}
                                    {% set favorable = (indicateur.evolution >= 0) != (indicateur.inverse ?? false) %}
                                    <div class="small evolution text-{{ indicateur.evolution == 0 ? 'body-secondary' : (favorable ? 'success' : 'danger') }}" title="Par rapport aux mêmes jours du mois précédent">
                                        <i class="bi bi-arrow-{{ indicateur.evolution >= 0 ? 'up' : 'down' }}-right"></i>
                                        {{ indicateur.evolution > 0 ? '+' }}{{ indicateur.evolution|number_format(1, ',', ' ') }} % vs mois précédent
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="row g-3">
        {% for code, graphique in graphiques %}
            <div class="col-12{{ code == 'categories' ? ' col-xl-5' : (code == 'mois' ? ' col-xl-7' : '') }}">
                <div class="card shadow-sm h-100" id="graphique-{{ code }}">
                    <div class="card-header bg-body d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">{{ graphique.titre }}</span>
                        {% if loop.first %}<span class="small text-body-secondary">{{ 'now'|date('d/m/Y H:i') }} (heure de Bamako)</span>{% endif %}
                    </div>
                    <div class="card-body">
                        {% if graphique.vide ?? false %}
                            <p class="text-body-secondary small mb-0">Aucune dépense ce mois-ci.</p>
                        {% else %}
                            <div class="chart-container">
                                <canvas {{ stimulus_controller('chart', {config: graphique.config, devise: graphique.devise}) }} aria-label="{{ graphique.titre }}"></canvas>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
