{% extends 'layout/app.html.twig' %}

{% block title %}Vue globale{% endblock %}

{% block page_actions %}
    <a class="btn btn-success" href="{{ path('admin_pharmacie_nouvelle') }}"><i class="bi bi-plus-lg"></i> Nouvelle pharmacie</a>
{% endblock %}

{% block content %}
    {% set tuiles = [
        ['Actives', compteurs.actif + compteurs.alerte + compteurs.grace, 'check-circle', 'success'],
        ["En période d'essai", compteurs.essai, 'hourglass-split', 'info'],
        ['Expirent sous 30 jours', compteurs.alerte, 'calendar-event', 'warning'],
        ['Expirées', compteurs.expire, 'calendar-x', 'danger'],
    ] %}
    <div class="row g-3 mb-4">
        {% for tuile in tuiles %}
            <div class="col-6 col-xl-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="bi bi-{{ tuile[2] }} fs-2 text-{{ tuile[3] }}"></i>
                        <div class="min-w-0">
                            <div class="small text-body-secondary">{{ tuile[0] }}</div>
                            <div class="fs-4 fw-semibold">{{ tuile[1] }}</div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    {% if compteurs.suspendu or compteurs.archive %}
        <p class="small text-body-secondary mt-n2">Hors totaux : {{ compteurs.suspendu }} suspendue(s), {{ compteurs.archive }} archivée(s).</p>
    {% endif %}

    <div class="row g-3">
        <div class="col-12 col-xl-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-body d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Revenus d'abonnement — 12 derniers mois</span>
                    <span class="fw-semibold text-success text-nowrap">{{ revenus_annee|fcfa }}</span>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas {{ stimulus_controller('chart', {config: graphique, devise: true}) }} aria-label="Revenus d'abonnement par mois"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-body fw-semibold">À surveiller</div>
                <ul class="list-group list-group-flush">
                    {% for ligne in a_surveiller|slice(0, 10) %}
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <div class="min-w-0">
                                <a class="fw-semibold text-decoration-none" href="{{ path('admin_pharmacie_voir', {id: ligne.pharmacie.id}) }}">{{ ligne.pharmacie.nom }}</a>
                                <div class="small text-body-secondary">{{ ligne.pharmacie.ville }} · échéance {{ ligne.etat.echeance ? ligne.etat.echeance|date('d/m/Y') : '—' }}</div>
                            </div>
                            <span class="badge text-bg-{{ ligne.etat.statut.couleur }} text-nowrap">{{ ligne.etat.statut.libelle }}</span>
                        </li>
                    {% else %}
                        <li class="list-group-item text-body-secondary text-center py-4">Aucune échéance proche.</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-3">
        <div class="card-header bg-body fw-semibold">Derniers paiements</div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th class="ps-3">Date</th><th>Pharmacie</th><th>Facture</th><th class="text-end pe-3">Montant</th></tr></thead>
                <tbody>
                    {% for paiement in derniers_paiements %}
                        <tr>
                            <td class="ps-3">{{ paiement.datePaiement|date('d/m/Y') }}</td>
                            <td><a href="{{ path('admin_pharmacie_voir', {id: paiement.pharmacie.id}) }}">{{ paiement.pharmacie.nom }}</a></td>
                            <td><a href="{{ path('admin_abonnement_facture', {id: paiement.id}) }}" target="_blank" rel="noopener">{{ paiement.numeroFacture }}</a></td>
                            <td class="montant pe-3">{{ paiement.montant|fcfa }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-center text-body-secondary py-3">Aucun paiement enregistré.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
