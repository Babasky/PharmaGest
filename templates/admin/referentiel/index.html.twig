{% extends 'layout/app.html.twig' %}

{% block title %}Référentiels communs{% endblock %}

{% block content %}
    <ul class="nav nav-tabs mb-3">
        {% for cle, t in types %}
            <li class="nav-item"><a class="nav-link{{ cle == type ? ' active' }}" href="{{ path('admin_referentiel_index', {type: cle}) }}">{{ t.titre }}</a></li>
        {% endfor %}
    </ul>
    <p class="small text-body-secondary">Ces listes sont proposées à toutes les pharmacies. Une valeur désactivée n'est plus proposée mais reste sur les données existantes.</p>
    <div class="row g-3">
        <div class="col-12 col-lg-7 order-2 order-lg-1">
            <div class="card shadow-sm">
                <ul class="list-group list-group-flush">
                    {% for valeur in valeurs %}
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2{{ valeur.actif ? '' : ' text-body-secondary' }}">
                            <span>{{ valeur.nom }}{% if valeur.code is defined %} <span class="badge text-bg-light border">{{ valeur.code }}</span>{% endif %}{% if not valeur.actif %} <span class="badge text-bg-secondary">Désactivé</span>{% endif %}</span>
                            <span class="d-flex gap-1">
                                <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_referentiel_modifier', {type: type, id: valeur.id}) }}" title="Modifier"><i class="bi bi-pencil"></i><span class="visually-hidden">Modifier {{ valeur.nom }}</span></a>
                                <form method="post" action="{{ path('admin_referentiel_activer', {type: type, id: valeur.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('referentiel-' ~ type ~ '-' ~ valeur.id) }}">
                                    <button class="btn btn-sm btn-outline-{{ valeur.actif ? 'danger' : 'success' }}">{{ valeur.actif ? 'Désactiver' : 'Réactiver' }}</button>
                                </form>
                            </span>
                        </li>
                    {% else %}
                        <li class="list-group-item text-center text-body-secondary py-4">Aucune valeur.</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        <div class="col-12 col-lg-5 order-1 order-lg-2">
            <div class="card shadow-sm">
                <div class="card-header bg-body fw-semibold">Ajouter</div>
                <div class="card-body">
                    {{ form_start(formulaire) }}
                    {{ form_widget(formulaire) }}
                    <button class="btn btn-success" type="submit">Ajouter</button>
                    {{ form_end(formulaire) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
