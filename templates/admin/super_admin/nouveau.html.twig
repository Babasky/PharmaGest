{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Nouveau super admin{% endblock %}
{% block content_title %}Nouveau super admin{% endblock %}

{% block main %}
    {{ form_start(formulaire) }}
    {{ form_errors(formulaire) }}
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-body fw-semibold">Compte</div>
                <div class="card-body">
                    {{ form_row(formulaire.nom) }}
                    {{ form_row(formulaire.email) }}
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2 mt-3">
        {# Le formulaire n'est envoyé qu'après confirmation dans la fenêtre ci-dessous. #}
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmer-super-admin">Créer le super admin</button>
        <a class="btn btn-secondary" href="{{ path('admin_super_admin_index') }}">Annuler</a>
    </div>

    <div class="modal fade" id="confirmer-super-admin" tabindex="-1" aria-labelledby="confirmer-super-admin-titre" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="confirmer-super-admin-titre"><i class="bi bi-exclamation-triangle text-danger"></i> Créer un super admin ?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p>Ce compte aura les mêmes droits que vous sur toute la plateforme : pharmacies, abonnements, offres, référentiels communs et création d'autres super admins.</p>
                    <p class="mb-0 text-body-secondary">La personne recevra un lien par email pour choisir son mot de passe. La création est inscrite au journal d'audit.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-person-check"></i> Oui, créer le super admin</button>
                </div>
            </div>
        </div>
    </div>
    {{ form_end(formulaire) }}
{% endblock %}
