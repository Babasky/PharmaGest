{% extends 'layout/app.html.twig' %}

{% block title %}Pharmacies{% endblock %}

{% block page_actions %}
    <a class="btn btn-success" href="{{ path('admin_pharmacie_nouvelle') }}"><i class="bi bi-plus-lg"></i> Nouvelle pharmacie</a>
{% endblock %}

{% block content %}
    <form method="get" class="mb-3" role="search">
        <div class="input-group" style="max-width: 28rem">
            <input type="search" name="q" value="{{ q }}" class="form-control" placeholder="Nom, ville ou n° d'autorisation" aria-label="Rechercher une pharmacie">
            <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i><span class="visually-hidden">Rechercher</span></button>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th class="ps-3">Pharmacie</th><th class="d-none d-md-table-cell">Téléphone</th><th>Offre</th><th>Échéance</th><th class="pe-3">Statut</th></tr>
                </thead>
                <tbody>
                    {% for pharmacie in pharmacies %}
                        {% set etat = etats[pharmacie.id] %}
                        <tr>
                            <td class="ps-3">
                                <a class="fw-semibold text-decoration-none" href="{{ path('admin_pharmacie_voir', {id: pharmacie.id}) }}">{{ pharmacie.nom }}</a>
                                <div class="small text-body-secondary">{{ pharmacie.ville }} · {{ pharmacie.numeroAutorisation }}</div>
                            </td>
                            <td class="d-none d-md-table-cell text-nowrap">{{ pharmacie.telephone|telephone }}</td>
                            <td>{{ pharmacie.offre.nom }}</td>
                            <td class="text-nowrap">{{ etat.echeance ? etat.echeance|date('d/m/Y') : '—' }}</td>
                            <td class="pe-3"><span class="badge text-bg-{{ etat.statut.couleur }}">{{ etat.statut.libelle }}</span></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-body-secondary py-4">{{ q ? 'Aucune pharmacie ne correspond à « ' ~ q ~ ' ».' : 'Aucune pharmacie pour le moment.' }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% include 'layout/_pagination.html.twig' with {page: pharmacies, route: 'admin_pharmacie_index', params: {q: q}} %}
{% endblock %}
