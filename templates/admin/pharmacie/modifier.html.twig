{% extends 'layout/app.html.twig' %}

{% block title %}Modifier {{ pharmacie.nom }}{% endblock %}

{% block content %}
    <div class="card shadow-sm" style="max-width: 40rem">
        <div class="card-body">
            {{ form_start(formulaire) }}
                {{ form_widget(formulaire) }}
                <div class="d-flex gap-2">
                    <button class="btn btn-success" type="submit">Enregistrer</button>
                    <a class="btn btn-outline-secondary" href="{{ path('admin_pharmacie_voir', {id: pharmacie.id}) }}">Annuler</a>
                </div>
            {{ form_end(formulaire) }}
        </div>
    </div>
{% endblock %}
