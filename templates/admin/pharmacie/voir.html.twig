{% extends '@EasyAdmin/page/content.html.twig' %}

{# Fiche d'une pharmacie (page « detail » de PharmacieCrudController) : abonnement, équipe, accès et paiements. #}
{% block page_title %}{{ pharmacie.nom }}{% endblock %}
{% block content_title %}{{ pharmacie.nom }}{% endblock %}

{% block page_actions %}
    <a class="btn btn-secondary" href="{{ path('admin_pharmacie_index') }}"><i class="bi bi-arrow-left"></i> Pharmacies</a>
    <a class="btn btn-primary" href="{{ path('admin_pharmacie_edit', {entityId: pharmacie.id}) }}"><i class="bi bi-pencil"></i> Modifier la fiche</a>
{% endblock %}

{% block main %}
    {% set jeton = csrf_token('pharmacie-' ~ pharmacie.id) %}
    <div class="row g-3">
        <div class="col-12 col-xl-5 d-flex flex-column gap-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <div class="small text-body-secondary">{{ pharmacie.ville }} · autorisation {{ pharmacie.numeroAutorisation }}</div>
                        <span class="badge text-bg-{{ etat.statut.couleur }} text-nowrap">{{ etat.statut.libelle }}</span>
                    </div>
                    <dl class="row small mb-0">
                        <dt class="col-5 fw-normal text-body-secondary">Adresse</dt><dd class="col-7">{{ pharmacie.adresse }}</dd>
                        <dt class="col-5 fw-normal text-body-secondary">Téléphone</dt><dd class="col-7 text-nowrap">{{ pharmacie.telephone|telephone }}</dd>
                        <dt class="col-5 fw-normal text-body-secondary">Email</dt><dd class="col-7 text-break">{{ pharmacie.email ?? '—' }}</dd>
                        <dt class="col-5 fw-normal text-body-secondary">Offre</dt><dd class="col-7">{{ pharmacie.offre.nom }}</dd>
                        <dt class="col-5 fw-normal text-body-secondary">Fin d'essai</dt><dd class="col-7">{{ pharmacie.finEssai ? pharmacie.finEssai|date('d/m/Y') : '—' }}</dd>
                        <dt class="col-5 fw-normal text-body-secondary">Fin d'abonnement</dt><dd class="col-7">{{ pharmacie.finAbonnement ? pharmacie.finAbonnement|date('d/m/Y') : '—' }}</dd>
                        <dt class="col-5 fw-normal text-body-secondary">Créée le</dt><dd class="col-7">{{ pharmacie.creeLe|date('d/m/Y') }}</dd>
                        {% if pharmacie.suspendue %}
                            <dt class="col-5 fw-normal text-body-secondary">Motif de suspension</dt><dd class="col-7">{{ pharmacie.motifSuspension }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-body fw-semibold">Équipe</div>
                <ul class="list-group list-group-flush">
                    {% for affectation in equipe %}
                        {% set membre = affectation.utilisateur %}
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <div class="min-w-0">
                                <div class="fw-semibold">{{ membre.nom }}</div>
                                <div class="small text-body-secondary text-break">{{ membre.email }} · {{ membre.libelleRole }}</div>
                            </div>
                            <div class="d-flex align-items-center gap-2 text-nowrap">
                                {% if not affectation.accesOuvert %}
                                    <span class="badge text-bg-secondary">Désactivé</span>
                                {% elseif not membre.active %}
                                    <span class="badge text-bg-warning">Activation en attente</span>
                                {% endif %}
                                {% if membre.proprietaire %}
                                    {% if affectation.actif and affectation.accesOuvert and proprietaires_actifs > 1 %}
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#retirer-proprietaire-{{ affectation.id }}">Retirer</button>
                                    {% elseif not affectation.actif %}
                                        <form method="post" action="{{ path('admin_pharmacie_reactiver_proprietaire', {id: pharmacie.id}) }}">
                                            <input type="hidden" name="_token" value="{{ jeton }}">
                                            <input type="hidden" name="affectation" value="{{ affectation.id }}">
                                            <button class="btn btn-sm btn-outline-success">Réactiver</button>
                                        </form>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
                <div class="card-body border-top">
                    <div class="fw-semibold small mb-2">Ajouter un propriétaire associé</div>
                    <p class="small text-body-secondary">Plusieurs pharmaciens peuvent détenir la pharmacie ensemble ; ils ont tous les droits du propriétaire. Un membre de l'équipe (adjoint…) peut aussi devenir propriétaire.</p>
                    {{ form_start(formulaire_associe) }}
                    <div class="row g-2">
                        <div class="col-12 col-md-6">{{ form_row(formulaire_associe.nom) }}</div>
                        <div class="col-12 col-md-6">{{ form_row(formulaire_associe.email) }}</div>
                    </div>
                    <button class="btn btn-sm btn-success" type="submit"><i class="bi bi-person-plus"></i> Ajouter le propriétaire</button>
                    {{ form_end(formulaire_associe) }}
                </div>
                {% if equipe|filter(a => a.utilisateur.proprietaire and a.actif and not a.utilisateur.active)|length > 0 %}
                    <div class="card-footer bg-body">
                        <form method="post" action="{{ path('admin_pharmacie_renvoyer_activation', {id: pharmacie.id}) }}">
                            <input type="hidden" name="_token" value="{{ jeton }}">
                            <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-envelope"></i> Renvoyer le lien d'activation aux propriétaires</button>
                        </form>
                    </div>
                {% endif %}
            </div>
            {% if proprietaires_actifs > 1 %}
                {% for affectation in equipe|filter(a => a.utilisateur.proprietaire and a.actif and a.accesOuvert) %}
                    {% embed 'layout/_confirmation.html.twig' with {
                        id: 'retirer-proprietaire-' ~ affectation.id,
                        titre: 'Retirer ce propriétaire ?',
                        action: path('admin_pharmacie_retirer_proprietaire', {id: pharmacie.id}),
                        jeton: jeton,
                        bouton: 'Oui, retirer',
                        icone: 'bi-person-x',
                    } %}
                        {% block message %}
                            <input type="hidden" name="affectation" value="{{ affectation.id }}">
                            <p>Vous allez retirer <strong>{{ affectation.utilisateur.nom }}</strong> ({{ affectation.utilisateur.email }}) des propriétaires de <strong>{{ pharmacie.nom }}</strong>.</p>
                            <p class="mb-0 text-body-secondary">Il ne pourra plus se connecter à cette pharmacie ; ses autres pharmacies ne changent pas. Son historique est conservé et vous pourrez le réactiver.</p>
                        {% endblock %}
                    {% endembed %}
                {% endfor %}
            {% endif %}

            <div class="card shadow-sm border-danger-subtle">
                <div class="card-header bg-body fw-semibold">Accès</div>
                <div class="card-body d-grid gap-2">
                    {% if pharmacie.suspendue or pharmacie.archivee %}
                        <form method="post" action="{{ path('admin_pharmacie_reactiver', {id: pharmacie.id}) }}">
                            <input type="hidden" name="_token" value="{{ jeton }}">
                            <button class="btn btn-outline-success w-100"><i class="bi bi-unlock"></i> Réactiver l'accès</button>
                        </form>
                    {% else %}
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#suspendre-pharmacie"><i class="bi bi-slash-circle"></i> Suspendre l'accès</button>
                        {% embed 'layout/_confirmation.html.twig' with {
                            id: 'suspendre-pharmacie',
                            titre: 'Suspendre cette pharmacie ?',
                            action: path('admin_pharmacie_suspendre', {id: pharmacie.id}),
                            jeton: jeton,
                            bouton: 'Oui, suspendre',
                            icone: 'bi-slash-circle',
                        } %}
                            {% block message %}
                                <p>Vous allez suspendre l'accès de <strong>{{ pharmacie.nom }}</strong>.</p>
                                <p class="text-body-secondary">Plus aucun membre de son équipe ne pourra se connecter tant que l'accès n'est pas réactivé. Ses données sont conservées.</p>
                                <label for="motif" class="form-label">Motif de suspension (impayé, fraude…)</label>
                                <input type="text" id="motif" name="motif" class="form-control" required maxlength="255">
                            {% endblock %}
                        {% endembed %}
                    {% endif %}
                    {% if not pharmacie.archivee %}
                        <div>
                            <button type="button" class="btn btn-sm btn-link text-danger px-0" data-bs-toggle="modal" data-bs-target="#archiver-pharmacie"><i class="bi bi-archive"></i> Archiver la pharmacie</button>
                        </div>
                        {% embed 'layout/_confirmation.html.twig' with {
                            id: 'archiver-pharmacie',
                            titre: 'Archiver cette pharmacie ?',
                            action: path('admin_pharmacie_archiver', {id: pharmacie.id}),
                            jeton: jeton,
                            bouton: 'Oui, archiver',
                            icone: 'bi-archive',
                        } %}
                            {% block message %}
                                <p>Vous allez archiver <strong>{{ pharmacie.nom }}</strong>.</p>
                                <p class="mb-0 text-body-secondary">Plus aucun membre de son équipe ne pourra se connecter. Ses données sont conservées et l'accès pourra être réactivé.</p>
                            {% endblock %}
                        {% endembed %}
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-7 d-flex flex-column gap-3">
            <div class="card shadow-sm" id="paiement">
                <div class="card-header bg-body fw-semibold">Enregistrer un paiement</div>
                <div class="card-body">
                    <p class="small text-body-secondary">
                        Nouvelle période : du <strong>{{ periode[0]|date('d/m/Y') }}</strong> au <strong>{{ periode[1]|date('d/m/Y') }}</strong>
                        (la prolongation part de la fin en cours si l'abonnement est encore actif).
                    </p>
                    {{ form_start(formulaire) }}
                    <div class="row g-2">
                        <div class="col-12 col-md-6">{{ form_row(formulaire.offre) }}</div>
                        <div class="col-12 col-md-6">{{ form_row(formulaire.montant) }}</div>
                        <div class="col-12 col-md-6">{{ form_row(formulaire.moyen) }}</div>
                        <div class="col-12 col-md-6">{{ form_row(formulaire.datePaiement) }}</div>
                        <div class="col-12">{{ form_row(formulaire.reference) }}</div>
                    </div>
                    <button class="btn btn-success" type="submit"><i class="bi bi-check2-circle"></i> Enregistrer et générer la facture</button>
                    {{ form_end(formulaire) }}
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-body fw-semibold">Historique des paiements</div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th class="ps-3">Facture</th><th>Période</th><th>Offre</th><th class="text-end pe-3">Montant</th></tr></thead>
                        <tbody>
                            {% for paiement in paiements %}
                                <tr>
                                    <td class="ps-3"><a href="{{ path('admin_abonnement_facture', {id: paiement.id}) }}" target="_blank" rel="noopener">{{ paiement.numeroFacture }}</a><div class="small text-body-secondary">{{ paiement.datePaiement|date('d/m/Y') }} · {{ paiement.moyen.libelle }}{{ paiement.reference ? ' · ' ~ paiement.reference }}</div></td>
                                    <td class="small text-nowrap">{{ paiement.dateDebut|date('d/m/Y') }} → {{ paiement.dateFin|date('d/m/Y') }}</td>
                                    <td>{{ paiement.offre.nom }}</td>
                                    <td class="montant pe-3">{{ paiement.montant|fcfa }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="4" class="text-center text-body-secondary py-3">Aucun paiement.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
