{% extends 'layout/app.html.twig' %}

{% block title %}Offres{% endblock %}

{% block content %}
    <p class="text-body-secondary small">Les limites sont appliquées automatiquement. Leur modification depuis cet écran arrive en V1 (SA-04) ; en attendant, elle se fait par migration.</p>
    <div class="row g-3">
        {% for offre in offres %}
            <div class="col-12 col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h5">{{ offre.nom }}</h2>
                        <dl class="row small mb-3">
                            <dt class="col-7 fw-normal text-body-secondary">Utilisateurs</dt><dd class="col-5 text-end">{{ offre.maxUtilisateurs ?? 'Illimités' }}</dd>
                            <dt class="col-7 fw-normal text-body-secondary">Pharmacies</dt><dd class="col-5 text-end">{{ offre.maxPharmacies }}</dd>
                            <dt class="col-7 fw-normal text-body-secondary">Tarif annuel</dt><dd class="col-5 text-end">{{ offre.tarifAnnuel is null ? 'À fixer' : offre.tarifAnnuel|fcfa }}</dd>
                        </dl>
                        <ul class="small mb-0 ps-3">
                            {% for fonction in offre.fonctions %}<li>{{ fonction }}</li>{% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
