{% extends 'layout/app.html.twig' %}

{% block title %}Caisse{% endblock %}

{% block page_actions %}
    {% if session %}
        <span class="align-self-center small text-body-secondary">
            <i class="bi bi-safe"></i> Session {{ session.numero }} · {{ app.user.nom }} · ouverte à {{ session.ouverteLe|date('H:i') }}
        </span>
    {% endif %}
    {% if vendeurs is not empty %}
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-people"></i> Changer de vendeur
            </button>
            <form method="post" action="{{ path('app_caisse_changer_vendeur') }}" class="dropdown-menu dropdown-menu-end p-3" style="min-width: 16rem">
                <input type="hidden" name="_token" value="{{ csrf_token('caisse') }}">
                <label class="form-label small" for="changer-utilisateur">Vendeur</label>
                <select class="form-select form-select-sm mb-2" id="changer-utilisateur" name="utilisateur">
                    {% for v in vendeurs %}
                        <option value="{{ v.id }}">{{ v.nom }}</option>
                    {% endfor %}
                </select>
                <label class="form-label small" for="changer-pin">Son code PIN</label>
                <input class="form-control form-control-sm mb-2" type="password" inputmode="numeric" maxlength="4" id="changer-pin" name="code_pin" autocomplete="off">
                <button class="btn btn-sm btn-success w-100" type="submit">Prendre la caisse</button>
            </form>
        </div>
    {% endif %}
    {% if session %}
        <a class="btn btn-outline-danger" href="{{ path('app_session_caisse_voir', {id: session.id}) }}"><i class="bi bi-lock"></i> Clôturer ma caisse</a>
    {% endif %}
{% endblock %}

{% block content %}
    {% set token = csrf_token('caisse') %}
    {% set remise_possible = panier and panier.remiseAutorisee %}
    {% if not session %}
        {# Sans caisse ouverte, le vendeur prépare la vente et l'envoie à la caisse ; il peut aussi ouvrir la sienne. #}
        <div class="alert alert-info d-flex flex-wrap align-items-center gap-3" id="caisse-fermee">
            {% if ecriture_autorisee() %}
                <span class="flex-grow-1"><i class="bi bi-info-circle"></i> Votre caisse n'est pas ouverte : validez vos ventes avec « Envoyer à la caisse », le caissier les encaissera. Pour encaisser vous-même, ouvrez votre caisse.</span>
                <form method="post" action="{{ path('app_caisse_ouvrir') }}" class="d-flex gap-2 align-items-center">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <input type="hidden" name="retour" value="caisse">
                    <label class="small text-nowrap" for="fond">Fond de caisse</label>
                    <input type="text" inputmode="numeric" class="form-control form-control-sm text-end" id="fond" name="fond" value="0" autocomplete="off" style="width: 8rem">
                    <button class="btn btn-sm btn-success text-nowrap" type="submit"><i class="bi bi-unlock"></i> Ouvrir la caisse</button>
                </form>
            {% else %}
                <span>Abonnement expiré : la caisse est bloquée.</span>
            {% endif %}
        </div>
    {% endif %}
    <div class="row g-3" {{ stimulus_controller('caisse') }}>
        <div class="col-12 col-xl-7">
            {# --- Recherche produit (nom, DCI) --- #}
            <form method="get" action="{{ path('app_caisse') }}" class="mb-3" role="search">
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="search" name="q" value="{{ q }}" class="form-control" placeholder="Nom, DCI" aria-label="Rechercher un produit" autofocus autocomplete="off" data-caisse-target="recherche">
                    <button class="btn btn-success" type="submit">Chercher</button>
                </div>
                <div class="form-text mt-3">Raccourcis : <kbd>F2</kbd> recherche · <kbd>F9</kbd> encaissement.</div>
            </form>

            {% if q %}
                <div class="card shadow-sm mb-3" id="resultats">
                    <div class="card-header bg-body d-flex justify-content-between">
                        <span class="fw-semibold">Résultats pour « {{ q }} »</span>
                        <a class="small" href="{{ path('app_caisse') }}">Fermer</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <tbody>
                                {% for produit in resultats %}
                                    {% set dispo = stocks[produit.id].stock ?? 0 %}
                                    <tr>
                                        <td class="ps-3">
                                            <span class="fw-semibold">{{ produit.nomCommercial }}</span>
                                            {% if produit.ordonnanceObligatoire %}
                                                <span class="badge text-bg-warning ms-1" title="Ordonnance obligatoire">Ord.</span>
                                            {% endif %}
                                            {% if produit.remboursableAmo %}
                                                <span class="badge text-bg-info ms-1" title="Remboursable AMO">AMO</span>
                                            {% endif %}
                                            <div class="small text-body-secondary">{{ [produit.dci, produit.dosage, produit.forme ? produit.forme.nom : null]|filter(v => v)|join(' · ') }}</div>
                                        </td>
                                        <td class="small text-nowrap">{{ produit.etagere ? produit.etagere.code : '—' }}</td>
                                        <td class="text-end text-nowrap {{ dispo == 0 ? 'text-danger fw-semibold' }}">{{ dispo == 0 ? 'Rupture' : dispo ~ ' en stock' }}</td>
                                        <td class="montant">{{ produit.prixVente|fcfa }}</td>
                                        <td class="pe-3" style="width: 9rem">
                                            {% if dispo > 0 %}
                                                <form method="post" action="{{ path('app_caisse_ajouter', {id: produit.id}) }}" class="input-group input-group-sm">
                                                    <input type="hidden" name="_token" value="{{ token }}">
                                                    <input type="number" name="quantite" value="1" min="1" max="{{ dispo }}" class="form-control text-end" aria-label="Quantité de {{ produit.nomCommercial }}">
                                                    <button class="btn btn-success" type="submit" title="Ajouter au panier"><i class="bi bi-cart-plus"></i><span class="visually-hidden">Ajouter {{ produit.nomCommercial }}</span></button>
                                                </form>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td class="text-center text-body-secondary py-3">Aucun produit ne correspond à « {{ q }} ».</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}

            {# --- Panier --- #}
            <div class="card shadow-sm" id="panier">
                <div class="card-header bg-body d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">
                        <i class="bi bi-cart3"></i> Panier
                        {% if panier and panier.lignes is not empty %} 
                            · {{ panier.nombreArticles }} article(s)
                        {% endif %}
                    </span>
                    {% if panier %}
                        <div class="d-flex gap-2">
                            <form method="post" action="{{ path('app_caisse_attente') }}" class="d-flex gap-1">
                                <input type="hidden" name="_token" value="{{ token }}">
                                <input type="text" name="repere" class="form-control form-control-sm" placeholder="Repère (facultatif)" maxlength="60" aria-label="Repère de la vente mise en attente" style="width: 10rem">
                                <button class="btn btn-sm btn-outline-warning text-nowrap" type="submit"><i class="bi bi-pause-circle"></i> Mettre en attente</button>
                            </form>
                            <form method="post" action="{{ path('app_caisse_abandonner') }}">
                                <input type="hidden" name="_token" value="{{ token }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit" data-turbo-confirm="Vider le panier ?"><i class="bi bi-trash"></i><span class="visually-hidden">Vider le panier</span></button>
                            </form>
                        </div>
                    {% endif %}
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th class="ps-3">Produit</th>
                                <th class="text-end">Prix</th>
                                <th style="width: 6rem">Qté</th>
                                {% if remise_possible and panier.type.value != 'amo' %}<th style="width: 11rem">Remise</th>{% endif %}
                                <th class="text-end">Montant</th>
                                <th class="pe-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ligne in panier ? panier.lignes : [] %}
                                {% set produit = ligne.produit %}
                                {% set form_id = 'ligne-' ~ ligne.id %}
                                <tr>
                                    <td class="ps-3">
                                        <span class="fw-semibold">{{ produit.nomCommercial }}</span>
                                        {% if produit.ordonnanceObligatoire %}<span class="badge text-bg-warning ms-1">Ord.</span>{% endif %}
                                        {% if panier.type.value == 'amo' %}<span class="badge {{ ligne.remboursable ? 'text-bg-info' : 'text-bg-light border' }} ms-1">{{ ligne.remboursable ? 'Remboursable' : 'Non remboursable' }}</span>{% endif %}
                                        <div class="small text-body-secondary">{{ produit.etagere ? 'Étagère ' ~ produit.etagere.code ~ ' · ' }}{{ stocks[produit.id].stock ?? 0 }} en stock</div>
                                    </td>
                                    <td class="montant small">{{ ligne.prixUnitaire|fcfa }}{% if panier.tarifAmo and ligne.remboursable and ligne.prixUnitaireAmo is not null and ligne.prixUnitaireAmo != ligne.prixUnitaire %}<div class="text-body-secondary" title="Prix de vente AMO">AMO {{ ligne.prixUnitaireAmo|fcfa }}</div>{% endif %}</td>
                                    <td>
                                        <form method="post" action="{{ path('app_caisse_ligne', {id: ligne.id}) }}" id="{{ form_id }}">
                                            <input type="hidden" name="_token" value="{{ token }}">
                                        </form>
                                        <input type="number" form="{{ form_id }}" name="quantite" value="{{ ligne.quantite }}" min="0" class="form-control form-control-sm text-end" aria-label="Quantité de {{ produit.nomCommercial }}" onchange="this.form.requestSubmit()">
                                    </td>
                                    {% if remise_possible and panier.type.value != 'amo' %}
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input type="text" inputmode="numeric" form="{{ form_id }}" name="remise_valeur" value="{{ ligne.remiseValeur ?: '' }}" class="form-control text-end" aria-label="Remise sur {{ produit.nomCommercial }}">
                                                <select form="{{ form_id }}" name="remise_type" class="form-select" aria-label="Type de remise" style="max-width: 5rem">
                                                    <option value="pourcentage"{{ ligne.remiseType and ligne.remiseType.value == 'montant' ? '' : ' selected' }}>%</option>
                                                    <option value="montant"{{ ligne.remiseType and ligne.remiseType.value == 'montant' ? ' selected' }}>F</option>
                                                </select>
                                            </div>
                                        </td>
                                    {% endif %}
                                    <td class="montant">
                                        {{ ligne.montantNet|fcfa }}
                                        {% if ligne.calculerRemise > 0 %}<div class="small text-success">− {{ ligne.calculerRemise|fcfa }}</div>{% endif %}
                                    </td>
                                    <td class="pe-3 text-nowrap">
                                        <button class="btn btn-sm btn-outline-secondary" type="submit" form="{{ form_id }}" title="Appliquer"><i class="bi bi-check2"></i><span class="visually-hidden">Appliquer</span></button>
                                        <button class="btn btn-sm btn-outline-danger" type="submit" form="{{ form_id }}" name="retirer" value="1" title="Retirer"><i class="bi bi-x-lg"></i><span class="visually-hidden">Retirer {{ produit.nomCommercial }}</span></button>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6" class="text-center text-body-secondary py-4">Le panier est vide. Cherchez un produit pour l'ajouter.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {% if en_attente is not empty %}
                <div class="card shadow-sm mt-3" id="en-attente">
                    <div class="card-header bg-body fw-semibold"><i class="bi bi-pause-circle"></i> Ventes en attente</div>
                    <ul class="list-group list-group-flush">
                        {% for attente in en_attente %}
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <span>
                                    <span class="fw-semibold">{{ attente.repere ?? (attente.client ? attente.client.nom : 'Client') }}</span>
                                    <span class="small text-body-secondary">· {{ attente.lignes|length }} produit(s) · {{ attente.calculer.aEncaisser|fcfa }} · {{ attente.vendeur.nom }}, {{ attente.creeLe|date('H:i') }}</span>
                                </span>
                                <form method="post" action="{{ path('app_caisse_reprendre', {id: attente.id}) }}">
                                    <input type="hidden" name="_token" value="{{ token }}">
                                    <button class="btn btn-sm btn-outline-success" type="submit"><i class="bi bi-play-circle"></i> Reprendre</button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% if a_encaisser is not empty %}
                <div class="card shadow-sm mt-3" id="a-encaisser">
                    <div class="card-header bg-body d-flex justify-content-between align-items-center">
                        <span class="fw-semibold"><i class="bi bi-hourglass-split"></i> Envoyées à la caisse, à encaisser</span>
                        <a class="small" href="{{ path('app_encaissement_index') }}">Encaissement</a>
                    </div>
                    <ul class="list-group list-group-flush">
                        {% for v in a_encaisser %}
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <span>
                                    <span class="fw-semibold font-monospace">{{ v.numero }}</span>
                                    <span class="small text-body-secondary">· {{ v.client ? v.client.nom : 'client de passage' }} · {{ v.montantEncaisse|fcfa }} · {{ v.vendeur.nom }}, {{ v.valideeLe|date('H:i') }}</span>
                                </span>
                                {% if session %}<a class="btn btn-sm btn-outline-success" href="{{ path('app_encaissement_voir', {id: v.id}) }}"><i class="bi bi-cash-coin"></i> Encaisser</a>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>

        <div class="col-12 col-xl-5">
            {# --- Client --- #}
            <div class="card shadow-sm mb-3" id="client" data-action="submit->caisse#garderVente">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <div class="small text-body-secondary">Client</div>
                            {% if panier and panier.client %}
                                <div class="fw-semibold">{{ panier.client.nom }}
                                    {% if panier.client.privilegie %}<span class="badge text-bg-success">Privilégié</span>{% endif %}
                                </div>
                                <div class="small text-body-secondary">{{ [panier.client.telephone ? panier.client.telephone|telephone : null, panier.client.assureAmo ? panier.client.organismeAmo.code ~ ' ' ~ panier.client.numeroAssure : null]|filter(v => v)|join(' · ') }}</div>
                            {% else %}
                                <div class="text-body-secondary">Aucun (client de passage)</div>
                            {% endif %}
                        </div>
                        {% if panier and panier.client %}
                            <form method="post" action="{{ path('app_caisse_client') }}">
                                <input type="hidden" name="_token" value="{{ token }}">
                                <input type="hidden" name="client" value="">
                                <button class="btn btn-sm btn-outline-secondary" type="submit">Retirer</button>
                            </form>
                        {% endif %}
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <form method="get" action="{{ path('app_caisse') }}" class="input-group input-group-sm" role="search">
                            <input type="search" name="client" value="{{ recherche_client }}" class="form-control" placeholder="Nom, téléphone ou n° d'assuré" aria-label="Rechercher un client">
                            <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i><span class="visually-hidden">Rechercher un client</span></button>
                        </form>
                        {% if ecriture_autorisee() %}
                            <button class="btn btn-sm btn-outline-success text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#nouveau-client" id="bouton-nouveau-client"><i class="bi bi-person-plus"></i> Nouveau client</button>
                        {% endif %}
                    </div>
                    {% if recherche_client %}
                        <ul class="list-group list-group-flush mt-2" id="clients-trouves">
                            {% for c in clients %}
                                <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                    <span>{{ c.nom }} {% if c.privilegie %}<span class="badge text-bg-success">Privilégié</span>{% endif %}{% if c.assureAmo %}<span class="badge text-bg-info">{{ c.organismeAmo.code }}</span>{% endif %}
                                        <span class="small text-body-secondary">{{ c.telephone ? c.telephone|telephone }}</span></span>
                                    <form method="post" action="{{ path('app_caisse_client') }}">
                                        <input type="hidden" name="_token" value="{{ token }}">
                                        <input type="hidden" name="client" value="{{ c.id }}">
                                        <button class="btn btn-sm btn-outline-success" type="submit">Choisir {{ c.nom }}</button>
                                    </form>
                                </li>
                            {% else %}
                                <li class="list-group-item px-0 small text-body-secondary">Aucun client trouvé.{% if ecriture_autorisee() %} <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-bs-toggle="modal" data-bs-target="#nouveau-client">Créer ce client</button>{% endif %}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>

            {# --- Type de vente, ordonnance, remise --- #}
            <form method="post" action="{{ path('app_caisse_vente') }}" enctype="multipart/form-data" class="card shadow-sm mb-3" id="type-vente" data-caisse-target="vente">
                <input type="hidden" name="_token" value="{{ token }}">
                <div class="card-body">
                    {% set type_courant = panier ? panier.type.value : 'sans_ordonnance' %}
                    <div class="btn-group w-100 mb-2" role="group" aria-label="Type de vente">
                        {% for type in types %}
                            <input type="radio" class="btn-check" name="type" id="type-{{ type.value }}" value="{{ type.value }}" autocomplete="off"{{ type.value == type_courant ? ' checked' }}>
                            <label class="btn btn-outline-success btn-sm" for="type-{{ type.value }}">{{ type.libelle }}</label>
                        {% endfor %}
                    </div>
                    {% set ord = panier ? panier.ordonnance : null %}
                    <fieldset class="row g-2 {{ type_courant == 'sans_ordonnance' ? 'opacity-75' }}">
                        <legend class="small text-body-secondary mb-0 col-12">Ordonnance (ordonnance classique ou AMO)</legend>
                        <div class="col-6"><input type="date" name="ordonnance_date" value="{{ ord and ord.date ? ord.date|date('Y-m-d') }}" class="form-control form-control-sm" aria-label="Date de l'ordonnance" max="{{ 'now'|date('Y-m-d') }}"></div>
                        <div class="col-6"><input type="text" name="ordonnance_numero" value="{{ ord ? ord.numero }}" class="form-control form-control-sm" placeholder="N° (facultatif)" aria-label="Numéro de l'ordonnance"></div>
                        <div class="col-6"><input type="text" name="ordonnance_prescripteur" value="{{ ord ? ord.prescripteur }}" class="form-control form-control-sm" placeholder="Prescripteur (facultatif)" aria-label="Prescripteur"></div>
                        <div class="col-6"><input type="text" name="ordonnance_structure" value="{{ ord ? ord.structure }}" class="form-control form-control-sm" placeholder="Structure (facultatif)" aria-label="Structure de santé"></div>
                        <div class="col-12">
                            <label class="form-label small text-body-secondary mb-0" for="ordonnance-copie">
                                Photo de l'ordonnance {{ type_courant == 'amo' ? '(jointe au bordereau AMO)' : '(facultatif)' }}
                                {% if ord and ord.copie %}
                                    <span class="badge text-bg-success" id="copie-jointe">
                                        <i class="bi bi-check"></i> jointe
                                    </span>
                                {% endif %}
                            </label>
                            <input type="file" name="ordonnance_copie" id="ordonnance-copie" accept="image/jpeg,image/png,image/webp,image/pdf" capture="environment" class="form-control form-control-sm">
                        </div>
                    </fieldset>
                    {% if not (panier and panier.client and panier.client.assureAmo) %}
                        {# Vente AMO sans client assuré : le client est facultatif, l'organisme se choisit ici. #}
                        <fieldset class="row g-2 mt-1 {{ type_courant != 'amo' ? 'opacity-75' }}" id="assurance-vente">
                            <legend class="small text-body-secondary mb-0 col-12">Assurance (vente AMO sans client assuré)</legend>
                            <div class="col-6">
                                <select name="organisme" class="form-select form-select-sm" aria-label="Organisme">
                                    <option value="">Organisme</option>
                                    {% for o in organismes %}
                                        <option value="{{ o.id }}"{{ panier and panier.organismeAmo and panier.organismeAmo.id == o.id ? ' selected' }}>{{ o.code }} · {{ o.nom }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-6"><input type="text" name="numero_assure" maxlength="40" value="{{ panier ? panier.numeroAssure }}" class="form-control form-control-sm" placeholder="N° d'assuré (facultatif)" aria-label="N° d'assuré"></div>
                        </fieldset>
                    {% endif %}
                    {% if remise_possible %}
                        <div class="mt-2">
                            <label class="form-label small text-body-secondary mb-1" for="remise-globale">Remise sur {{ panier.type.value == 'amo' ? 'la part assuré' : 'le total' }} (plafond {{ parametres.plafondRemise }} %)</label>
                            <div class="input-group input-group-sm">
                                <input type="text" inputmode="numeric" id="remise-globale" name="remise_valeur" value="{{ panier.remiseValeur ?: '' }}" class="form-control text-end">
                                <select name="remise_type" class="form-select" aria-label="Type de remise" style="max-width: 5rem">
                                    <option value="pourcentage"{{ panier.remiseType and panier.remiseType.value == 'montant' ? '' : ' selected' }}>%</option>
                                    <option value="montant"{{ panier.remiseType and panier.remiseType.value == 'montant' ? ' selected' }}>FCFA</option>
                                </select>
                            </div>
                        </div>
                    {% else %}
                        <p class="small text-body-secondary mt-2 mb-0" id="remise-indisponible">
                            <i class="bi bi-info-circle"></i> Remise indisponible : elle est réservée aux clients privilégiés.
                        </p>
                    {% endif %}
                    <button class="btn btn-sm btn-outline-success mt-2" type="submit">Appliquer</button>
                </div>
            </form>

            {# --- Totaux et encaissement --- #}
            <div class="card shadow-sm border-success" id="encaissement">
                <div class="card-body">
                    {% if totaux %}
                        <dl class="row mb-2" id="totaux">
                            <dt class="col-7 fw-normal">Total</dt><dd class="col-5 montant mb-1">{{ totaux.totalBrut|fcfa }}</dd>
                            {% if panier.type.value == 'amo' %}
                                <dt class="col-7 fw-normal" id="part-organisme">Part {{ panier.organismeAmo ? panier.organismeAmo.code : 'assurance' }} ({{ panier.tauxAmo ?? 0 }} % de {{ totaux.baseAmo|fcfa }}{{ panier.tarifAmo ? ', prix AMO' }})</dt><dd class="col-5 montant mb-1">− {{ totaux.partAmo|fcfa }}</dd>
                                <dt class="col-7 fw-normal">Part assuré</dt><dd class="col-5 montant mb-1">{{ totaux.partAssureAvantRemise|fcfa }}</dd>
                            {% endif %}
                            {% if totaux.remiseTotale > 0 %}
                                <dt class="col-7 fw-normal text-success">Remise</dt><dd class="col-5 montant text-success mb-1">− {{ totaux.remiseTotale|fcfa }}</dd>
                            {% endif %}
                            <dt class="col-7 fs-5">À payer</dt><dd class="col-5 montant fs-4 fw-bold mb-0" data-caisse-target="du" data-montant="{{ totaux.aEncaisser }}">{{ totaux.aEncaisser|fcfa }}</dd>
                        </dl>
                    {% else %}
                        <p class="text-body-secondary">Ajoutez des produits pour encaisser.</p>
                    {% endif %}

                    {% if controle %}
                        {% for message in controle.blocages %}<div class="alert alert-danger py-2 small mb-2"><i class="bi bi-x-octagon"></i> {{ message }}</div>{% endfor %}
                        {% for message in controle.autorisations %}<div class="alert alert-warning py-2 small mb-2"><i class="bi bi-shield-lock"></i> {{ message }}</div>{% endfor %}
                    {% endif %}

                    {% if panier and panier.lignes is not empty and ecriture_autorisee() %}
                        {% set bloquee = controle and controle.estBloquee %}
                        <form method="post" action="{{ path(session ? 'app_caisse_encaisser' : 'app_caisse_envoyer') }}">
                            <input type="hidden" name="_token" value="{{ token }}">
                            {% if session %}
                                {% include 'caisse/_paiements.html.twig' with {du: totaux.aEncaisser} %}
                            {% endif %}
                            {% if controle and controle.exigeCodePin %}
                                <div class="mb-2">
                                    <label class="form-label small mb-1" for="code-pin">Code PIN du propriétaire</label>
                                    <input type="password" inputmode="numeric" maxlength="4" class="form-control" id="code-pin" name="code_pin" autocomplete="off">
                                </div>
                            {% endif %}
                            {% if session %}
                                <button class="btn btn-success btn-lg w-100" type="submit"{{ bloquee ? ' disabled' }}><i class="bi bi-cash-coin"></i> Encaisser</button>
                                <button class="btn btn-outline-success w-100 mt-2" type="submit" formaction="{{ path('app_caisse_envoyer') }}"{{ bloquee ? ' disabled' }}><i class="bi bi-send"></i> Envoyer à la caisse</button>
                            {% else %}
                                <button class="btn btn-success btn-lg w-100" type="submit"{{ bloquee ? ' disabled' }}><i class="bi bi-send"></i> Envoyer à la caisse</button>
                            {% endif %}
                            <div class="form-text">« Envoyer à la caisse » valide la vente et sort les produits du stock ; le client la règle auprès du caissier.</div>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>

        {# --- Fenêtre « Nouveau client » : le client est créé et choisi sans quitter la caisse --- #}
        {% if ecriture_autorisee() %}
            <div class="modal fade" id="nouveau-client" tabindex="-1" aria-labelledby="nouveau-client-titre" aria-hidden="true" data-caisse-target="fenetreClient">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="nouveau-client-titre"><i class="bi bi-person-plus"></i> Nouveau client</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                        </div>
                        <div class="modal-body" data-caisse-target="corpsClient">
                            {% include 'caisse/_nouveau_client.html.twig' %}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
